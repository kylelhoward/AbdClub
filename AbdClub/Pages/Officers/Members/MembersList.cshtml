@page
@model AbdClub.Pages.Officers.Members.MembersListModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Manage Members";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
                <!-- Breadcrumb Routing Consistency -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Members List</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="bi bi-mailbox2 me-2"></i>Members</h2>
                <p class="text-muted mb-0">Manage club members and their statuses</p>
            </div>
           
        </div>

        <div>
            <a class="btn btn-primary" href="/Officers/Members/AddMember">Add Member</a>
        </div>
    </div>

    <nav class="mb-3" aria-label="Member filters">
        <ul class="nav nav-pills flex-wrap">
            <li class="nav-item">
                <a class="nav-link @(Model.Filter == "all" ? "active" : "")" href="?filter=all">All</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.Filter == "active" ? "active" : "")" href="?filter=active">Active</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.Filter == "expiring" ? "active" : "")" href="?filter=expiring">Expiring Soon</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.Filter == "expired" ? "active" : "")" href="?filter=expired">Expired</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.Filter == "officers" ? "active" : "")" href="?filter=officers">Officers</a>
            </li>
        </ul>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-info">
            @Model.Members.Count member(s) found.
        </div>
        <div>
            <form class="d-flex" method="get" role="search" aria-label="Search members">
                <input name="q" value="@(Request.Query["q"])" class="form-control form-control-sm me-2" placeholder="Search name or email" />
                <button class="btn btn-outline-secondary btn-sm" type="submit">Search</button>
            </form>
        </div>
    </div>

    @if (!Model.Members.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5 class="card-title mb-1">No members found</h5>
                <p class="text-muted mb-3">No members match this filter or search.</p>
                <a class="btn btn-outline-primary" href="?filter=all">Show all members</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Joined</th>
                        <th scope="col">Expires</th>
                        <th scope="col">Role</th>
                        <th scope="col" class="text-center">Status</th>
                        <th scope="col">Source</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        var now = DateTime.UtcNow;
                        var expiry = member.ExpiryDate;
                        var isExpired = expiry.HasValue && expiry.Value < now;
                        var isExpiringSoon = expiry.HasValue && !isExpired && expiry.Value < now.AddDays(30);

                        <tr class="@(isExpired ? "table-danger" : "")">
                           <td>
                               <div class="d-flex align-items-center flex-wrap gap-2">
                                   <div class="fw-semibold">@member.FullName</div>
        
        
                                @if (member.IsTechAdmin)
                                {
                                    <span class="badge bg-danger d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1 rounded" style="font-size: 0.7rem;"> <i class="bi bi-cpu-fill text-warning"></i> TechAdmin </span>
                                }
                                else if (member.IsAdmin)
                                {
                                    <span class="badge bg-warning text-dark d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1 rounded" style="font-size: 0.7rem;"> <i class="bi bi-shield-lock-fill"></i> Admin </span>
                                }
                                else if (member.IsOfficer)
                                {
                                    <span class="badge bg-primary d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1 rounded" style="font-size: 0.7rem;"> <i class="bi bi-award-fill"></i> Officer </span>
                                }
                                </div>
                                <div class="text-muted small"><a href="mailto:@member.Email">@member.Email</a></div>
                            </td>

                          <td>
                                <span class="small text-muted">@member.JoinDate.ToString("MMM d, yyyy")</span>
                            </td>
                            <td>
                                @if (expiry.HasValue)
                                {
                                    <span class="small">@expiry.Value.ToString("MMM d, yyyy")</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Lifetime</span>
                                }
                            </td>
                            <td>
                                @if (member.IsOfficer)
                                {
                                    <span class="badge bg-primary">@member.OfficerRole</span>
                                }
                                else
                                {
                                    <span class="text-muted">Member</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!member.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-danger">Expired</span>
                                }
                                else if (isExpiringSoon)
                                {
                                    <span class="badge bg-warning text-dark">Expiring soon</span>
                                }
                                else if (!expiry.HasValue)
                                {
                                    <span class="badge bg-info text-dark">No expiry</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                @if (member.SelfRegistered)
                                {
                                    <span class="badge bg-info text-dark">Online</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Manual</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group" aria-label="Actions for @member.FullName">
                                    @if ((await AuthorizationService.AuthorizeAsync(User, null, "isAdmin")).Succeeded)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="/Officers/Members/EditMember/@member.Id">Edit</a>
                                    }
                                    <a class="btn btn-sm btn-outline-secondary" href="/Officers/Members/ViewMember/@member.Id">View</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

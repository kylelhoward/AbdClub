@page
@model AbdClub.Pages.Officers.Announcements.EditModel
@{
    ViewData["Title"] = "Edit Announcement Flyer";
}

<div class="container py-4" style="max-width: 960px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Announcement Flyer</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h2 fw-bold mb-1">Edit Announcement Flyer</h1>
            <p class="text-muted mb-0">Changes appear immediately on the public announcements page.</p>
        </div>
        <a asp-page="/Announcements" class="btn btn-outline-danger" target="_blank">
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View flyer
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <form method="post" id="flyer-editor">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="bi bi-type" aria-hidden="true"></i> Flyer text and links
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label asp-for="Input.Greeting" class="form-label fw-bold"></label>
                    <input asp-for="Input.Greeting" class="form-control" />
                    <span asp-validation-for="Input.Greeting" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.MembershipUrl" class="form-label fw-bold"></label>
                    <input asp-for="Input.MembershipUrl" class="form-control" type="url" />
                    <div class="form-text">The QR code is regenerated automatically from this address.</div>
                    <span asp-validation-for="Input.MembershipUrl" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Input.WebsiteUrl" class="form-label fw-bold"></label>
                    <input asp-for="Input.WebsiteUrl" class="form-control" type="url" />
                    <span asp-validation-for="Input.WebsiteUrl" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-megaphone" aria-hidden="true"></i> Main announcements</span>
                <button type="button" class="btn btn-sm btn-light" data-add-item="announcements">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Add announcement
                </button>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small">Use the arrows to control the order shown on the flyer. Blank rows are ignored.</p>
                <div id="announcements-list" class="editor-list">
                    @for (var i = 0; i < Model.Input.Announcements.Count; i++)
                    {
                        <div class="editor-item" data-item>
                            <div class="editor-order-buttons">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" aria-label="Move announcement up"><i class="bi bi-arrow-up"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" aria-label="Move announcement down"><i class="bi bi-arrow-down"></i></button>
                            </div>
                            <div class="flex-grow-1">
                                <textarea asp-for="Input.Announcements[i].Text" class="form-control" rows="2" placeholder="Enter an announcement"></textarea>
                                <span asp-validation-for="Input.Announcements[i].Text" class="text-danger"></span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-remove aria-label="Remove announcement"><i class="bi bi-trash"></i></button>
                        </div>
                    }
                </div>
                <p class="empty-list-message text-muted fst-italic mb-0">No announcements have been added.</p>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-people" aria-hidden="true"></i> Help wanted</span>
                <button type="button" class="btn btn-sm btn-light" data-add-item="help">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Add help request
                </button>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small">List vacant board positions or other volunteer needs. Descriptions are optional.</p>
                <div id="help-list" class="editor-list">
                    @for (var i = 0; i < Model.Input.HelpWantedItems.Count; i++)
                    {
                        <div class="editor-item" data-item>
                            <div class="editor-order-buttons">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" aria-label="Move help request up"><i class="bi bi-arrow-up"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" aria-label="Move help request down"><i class="bi bi-arrow-down"></i></button>
                            </div>
                            <div class="flex-grow-1 row g-2">
                                <div class="col-md-4">
                                    <input asp-for="Input.HelpWantedItems[i].Title" class="form-control" placeholder="Position or volunteer need" />
                                    <span asp-validation-for="Input.HelpWantedItems[i].Title" class="text-danger"></span>
                                </div>
                                <div class="col-md-8">
                                    <input asp-for="Input.HelpWantedItems[i].Description" class="form-control" placeholder="Optional short description" />
                                    <span asp-validation-for="Input.HelpWantedItems[i].Description" class="text-danger"></span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-remove aria-label="Remove help request"><i class="bi bi-trash"></i></button>
                        </div>
                    }
                </div>
                <p class="empty-list-message text-muted fst-italic mb-0">No help requests have been added.</p>
            </div>
        </section>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-page="/Announcements" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-check-circle" aria-hidden="true"></i> Save flyer
            </button>
        </div>
    </form>
</div>

<template id="announcement-template">
    <div class="editor-item" data-item>
        <div class="editor-order-buttons">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" aria-label="Move announcement up"><i class="bi bi-arrow-up"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" aria-label="Move announcement down"><i class="bi bi-arrow-down"></i></button>
        </div>
        <div class="flex-grow-1"><textarea class="form-control" rows="2" placeholder="Enter an announcement" data-field="Text" maxlength="500"></textarea></div>
        <button type="button" class="btn btn-sm btn-outline-danger" data-remove aria-label="Remove announcement"><i class="bi bi-trash"></i></button>
    </div>
</template>

<template id="help-template">
    <div class="editor-item" data-item>
        <div class="editor-order-buttons">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" aria-label="Move help request up"><i class="bi bi-arrow-up"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" aria-label="Move help request down"><i class="bi bi-arrow-down"></i></button>
        </div>
        <div class="flex-grow-1 row g-2">
            <div class="col-md-4"><input class="form-control" placeholder="Position or volunteer need" data-field="Title" maxlength="120" /></div>
            <div class="col-md-8"><input class="form-control" placeholder="Optional short description" data-field="Description" maxlength="300" /></div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger" data-remove aria-label="Remove help request"><i class="bi bi-trash"></i></button>
    </div>
</template>

<style>
    .editor-list { display: grid; gap: .75rem; }
    .editor-item { display: flex; align-items: center; gap: .75rem; padding: .75rem; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: .5rem; }
    .editor-order-buttons { display: grid; gap: .25rem; }
    .editor-order-buttons .btn { line-height: 1; padding: .2rem .4rem; }
    .editor-list:not(:empty) + .empty-list-message { display: none; }
    @@media (max-width: 575px) { .editor-item { align-items: flex-start; } }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const announcementList = document.getElementById('announcements-list');
            const helpList = document.getElementById('help-list');

            function reindex(list, collectionName) {
                list.querySelectorAll('[data-item]').forEach((item, index) => {
                    item.querySelectorAll('[data-field]').forEach(field => {
                        field.name = `Input.${collectionName}[${index}].${field.dataset.field}`;
                        field.id = `Input_${collectionName}_${index}__${field.dataset.field}`;
                    });

                    // Existing server-rendered controls do not need data-field attributes.
                    item.querySelectorAll('input[name], textarea[name]').forEach(field => {
                        const property = field.name.split('.').pop();
                        field.name = `Input.${collectionName}[${index}].${property}`;
                    });
                });
            }

            function configureList(list, collectionName) {
                list.addEventListener('click', event => {
                    const removeButton = event.target.closest('[data-remove]');
                    const moveButton = event.target.closest('[data-move]');
                    const item = event.target.closest('[data-item]');
                    if (!item) return;

                    if (removeButton) item.remove();
                    if (moveButton?.dataset.move === 'up' && item.previousElementSibling)
                        list.insertBefore(item, item.previousElementSibling);
                    if (moveButton?.dataset.move === 'down' && item.nextElementSibling)
                        list.insertBefore(item.nextElementSibling, item);

                    reindex(list, collectionName);
                });
            }

            configureList(announcementList, 'Announcements');
            configureList(helpList, 'HelpWantedItems');

            document.querySelector('[data-add-item="announcements"]').addEventListener('click', () => {
                announcementList.append(document.getElementById('announcement-template').content.cloneNode(true));
                reindex(announcementList, 'Announcements');
                announcementList.lastElementChild.querySelector('textarea').focus();
            });

            document.querySelector('[data-add-item="help"]').addEventListener('click', () => {
                helpList.append(document.getElementById('help-template').content.cloneNode(true));
                reindex(helpList, 'HelpWantedItems');
                helpList.lastElementChild.querySelector('input').focus();
            });

            document.getElementById('flyer-editor').addEventListener('submit', () => {
                reindex(announcementList, 'Announcements');
                reindex(helpList, 'HelpWantedItems');
            });
        })();
    </script>
}

@page
@model AbdClub.Pages.Officers.Dances.PrintManifestsModel
@{
    Layout = null; // 🌟 Completely strips away site layout menus, banners, and headers
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Event Logistics Manifest Registry</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { font-size: 13px; color: #000; background: #fff; }
        .print-page { page-break-after: always; padding: 20px 0; }
        .print-page:last-child { page-break-after: avoid; }
        .table th { background-color: #f2f2f2 !important; color: #000 !important; font-size: 11px; text-uppercase; }
        .checkbox-cell { width: 40px; text-align: center; }
        .blank-underline { border-bottom: 1px solid #000; display: inline-block; width: 250px; height: 18px; vertical-align: bottom; }
        .checkbox-square { border: 1px solid #000; width: 14px; height: 14px; display: inline-block; }
        
        /* 🌟 ENFORCES HARD CSS PRINTER BREAK LIFECYCLES */
            @@media print {
                .no-print {
                    display: none !important;
                }
            body { padding: 0; margin: 0; }
            .print-page { page-break-after: always; }
        }
    </style>
</head>
<body>

    <!-- UTILITY SYSTEM ACTION BAR: Stays invisible on paper -->
    <div class="bg-light p-3 border-bottom mb-4 no-print d-flex justify-content-between align-items-center">
        <div>
            <strong class="text-dark">Print Manifest Workspace</strong>
            <span class="text-muted small ms-2">Verify forms below before dispatching layout items to hardware channels.</span>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-sm btn-dark fw-bold"><i class="bi bi-printer"></i> Execute Hard Copy Print</button>
            <button onclick="window.close()" class="btn btn-sm btn-outline-secondary">Close Tab</button>
        </div>
    </div>

    <div class="container-fluid">

        @* ==========================================
           MANIFEST 1: ACTIVE MEMBERS SIGN-IN
           ========================================== *@
        @if (Model.SelectedForms.Contains("active-members"))
        {
            <div class="print-page">
                <div class="border-bottom pb-2 mb-3">
                    <!-- 🌟 UPDATED: Refactored title text parameters -->
                    <h4 class="fw-bold m-0"><i class="bi bi-person-check-fill me-2"></i>ABD - Active Member Sign-In</h4>
                    <p class="text-muted m-0 small">
                        Event: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Title) | 
                        Date: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Date.ToString("yyyy-MM-dd")) 
                    </p>
                    <p class="text-muted m-0 small">
                        <!-- 🌟 DYNAMIC ADMISSION FEE: Pulls straight out of your local appsettings configurations matrix -->
                        <strong>Admission Fee: @(Model.IsGeneric ? "$________" : Model.ConfiguredAdmissionFee)</strong>
                    </p>

                </div>


                    <table class="table table-bordered table-sm align-middle">
                        <thead>
                            <tr>
                                <th class="checkbox-cell">Sign In</th>
                                <th>Full Name</th>
                                <th>Email Address</th>
                                <th style="width: 110px;">Expiration</th>
                                <th class="checkbox-cell">Cash</th>
                                <th class="checkbox-cell">Card</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.IsGeneric || !Model.ActiveRoster.Any())
                        {
                            @for (int i = 1; i < 40; i++) {
                                <tr style="height: 32px;">
                                    <td class="text-center">
                                        <span class="checkbox-square"></span>
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-center">
                                        <span class="checkbox-square"></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="checkbox-square"></span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            foreach (var member in Model.ActiveRoster)
                            {
                                <tr style="height: 28px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="fw-bold text-danger opacity-75">@member.LastName, @member.FirstName</td>
                                    <td class="text-muted">@member.Email</td>
                                    <td>@member.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ==========================================
           MANIFEST 2: INACTIVE MEMBERS MATRIX
           ========================================== *@
        @if (Model.SelectedForms.Contains("inactive-members"))
        {
            <div class="print-page">
               <div class="border-bottom pb-2 mb-3">
                    <!-- 🌟 UPDATED: Refactored title text parameters -->
                    <h4 class="fw-bold m-0"><i class="bi bi-person-check-fill me-2"></i>ABD - Lapsed Member Renewal Form</h4>
                    <p class="text-muted m-0 small">
                        Event: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Title) | 
                        Date: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Date.ToString("yyyy-MM-dd")) 
                    </p>
                    <p class="text-muted m-0 small">
                        <!-- 🌟 DYNAMIC RENEWAL FEE: Pulls straight out of your local appsettings configurations matrix -->
                        <strong>Renewal Fee: @(Model.IsGeneric ? "$________" : Model.ConfiguredRenewalFee)</strong>
                    </p>
               </div>

                <table class="table table-bordered table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="checkbox-cell">Renew</th>

                            <th>Full Name</th>
                            <th>Email Address</th>
                            <th style="width: 120px;">Lapsed Expiry</th>
                            <th class="checkbox-cell">Cash</th>
                            <th class="checkbox-cell">Card</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.IsGeneric || !Model.InactiveRoster.Any())
                        {
                            @for (int i = 0; i < 16; i++) {
                                <tr style="height: 32px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                   <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            foreach (var member in Model.InactiveRoster)
                            {
                                <tr style="height: 28px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="fw-bold text-danger opacity-75">@member.LastName, @member.FirstName</td>
                                    <td class="text-muted">@member.Email</td>
                                    <td>@member.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        @* End Manifest 2 *@
             
        
        @* ==========================================
           MANIFEST 3: COMPREHENSIVE EVENT DUTY LOG
           ========================================== *@
        @if (Model.SelectedForms.Contains("duty-log"))
        {
            <div class="print-page">
                <div class="d-flex justify-content-between align-items-baseline border-bottom pb-2 mb-3">
                    <div>
                        <h4 class="fw-bold m-0"><i class="bi bi-shield-lock-fill me-2"></i>Official Event Duty Log & Staff Manifest</h4>
                        <p class="text-muted m-0 small">
                            Event: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Title) | 
                            Location: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Location?.VenueName) |
                            Date: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Date.ToString("yyyy-MM-dd"))
                        </p>
                    </div>
                </div>

                <!-- SUBSECTION A: SCHEDULED SYSTEM EXECUTIVE & STAFF OFFICERS -->
                <h6 
                    class="fw-bold text-dark text-uppercase tracking-wider small mb-2">
                    <i class="bi bi-person-badge-fill me-1"></i>1. Scheduled Administration Duty Officers</h6>
                <table class="table table-bordered table-sm align-middle mb-4">
                    <thead>
                        <tr>
                            <th class="checkbox-cell">Sign-In</th>
                            <th style="width: 280px;">Officer Name</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                   <tbody>
    @{
        // Track the number of database records printed
        int printedRowsCount = 0;
    }

    <!-- 1. Print all currently assigned database officers -->
    @if (!Model.IsGeneric && Model.TargetDance?.AttendingOfficers != null)
    {
        foreach (var officer in Model.TargetDance.AttendingOfficers.OrderBy(o => o.LastName))
        {
            printedRowsCount++;
            <tr style="height: 35px;">
                <td class="text-center"><span class="checkbox-square"></span></td>
                <td class="fw-bold">@officer.LastName, @officer.FirstName</td>
                <td class="text-secondary font-monospace small">@officer.OfficerRole</td>
            </tr>
        }
    }

    <!-- 2. 🌟 MINIMUM FILLER LOOP: Generates empty padding rows to guarantee exactly 4 slots -->
    @for (int i = printedRowsCount; i < 4; i++)
    {
        <tr style="height: 35px;">
            <td class="text-center">
                <span class="checkbox-square"></span>
             </td>
            <td> </td>
            <td> </td>
        </tr>
    }
</tbody>

                </table>

                <!-- SUBSECTION B: EVENT PROFESSIONALS & ASSIGNED CLUB DANCE HOSTS -->
                <h6 
                    class="fw-bold text-dark text-uppercase tracking-wider small mb-2">
                    <i class="bi bi-music-note-beamed me-1"></i>2. Scheduled Event Professionals & Dance Hosts</h6>
                <table class="table table-bordered table-sm align-middle mb-4">
                    <thead>
                        <tr>
                            <th class="checkbox-cell">Sign-In</th>
                            <th style="width: 280px;">Operational Assignment Role</th>
                            <th>Assigned Professional / Host Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 1. The Single 1:1 Lesson Instructor Slot -->
                        <tr style="height: 35px;">
                            <td class="text-center"><span class="checkbox-square"></span></td>
                            <td class="fw-bold bg-light">Dance Instructor</td>
                            <td>
                                @(Model.IsGeneric ? "" : 
                                  (Model.TargetDance?.AssignedLesson?.Instructor != null ? Model.TargetDance.AssignedLesson.Instructor.Name : "VACANT / UNASSIGNED"))
                            </td>
                        </tr>

                        <!-- 2. The Single Assigned Event DJ Slot -->
                        <tr style="height: 35px;">
                            <td class="text-center"><span class="checkbox-square"></span></td>
                            <td class="fw-bold bg-light">Event Disc Jockey (DJ)</td>
                            <td>
                                @(Model.IsGeneric ? "" : 
                                  (Model.TargetDance?.AssignedDj != null ? Model.TargetDance.AssignedDj.Name : "VACANT / UNASSIGNED"))
                            </td>
                        </tr>

                        <!-- 3. Dynamic Loops Across Many-to-Many Assigned Hosts -->
    @{
        // Track the number of database records printed
        int printedHostRowsCount = 1;
    }
                        @if (!Model.IsGeneric || Model.TargetDance?.AssignedHosts != null)
                        {
                            foreach (var host in Model.TargetDance.AssignedHosts)
                            {
                                <tr style="height: 32px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="fw-bold bf-light">Dance Host #@(printedHostRowsCount++)</td>
                                    <td>@host.Name</td>
                                </tr>
                            }  
                           
                        }
                             @for (int i = printedHostRowsCount; i <= 4; i++) {
                                <tr style="height: 34px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="fw-bold bg-light">Dance Host #@i</td>
                                    <td></td>
                                </tr>
                            }
                    </tbody>
                </table>

                <!-- SUBSECTION C: SHIFT VOLUNTEERS REGISTER -->
                <h6 class="fw-bold text-dark text-uppercase tracking-wider small mb-2"><i class="bi bi-people-fill me-1"></i>3. Public Shift Volunteers</h6>
                <table class="table table-bordered table-sm align-middle">
                    <thead>
                        <tr>
                            <th class="checkbox-cell">Sign-In</th>
                            <th style="width: 280px;">Assigned Shift Duty Station</th>
                            <th>Volunteer Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.IsGeneric || Model.TargetDance?.AssignedVolunteers == null || !Model.TargetDance.AssignedVolunteers.Any())
                        {
                            var coreDuties = new[] { "Front Desk Check-in", "Setup Team", "Clean Up Crew" };
                            foreach (var duty in coreDuties)
                            {
                                <tr style="height: 35px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="fw-semibold text-secondary">@duty</td>
                                    <td></td>
                                </tr>
                            }
                        }
                        else
                        {
                            foreach (var volunteer in Model.TargetDance.AssignedVolunteers)
                            {
                                <tr style="height: 32px;">
                                    <td class="text-center"><span class="checkbox-square"></span></td>
                                    <td class="fw-semibold text-secondary">@volunteer.Notes</td> <!-- Assuming shift context is mapped inside Notes -->
                                    <td class="fw-bold text-dark">@volunteer.Name</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }


        @* End Manifest 3 *@

        @* ==========================================
           MANIFEST 4: NEW MEMBER SIGN-UP INTAKE LEDGER
           ========================================== *@
        @if (Model.SelectedForms.Contains("new-signup"))
        {
            <div class="print-page">
                               <div class="border-bottom pb-2 mb-3">
                    <!-- 🌟 UPDATED: Refactored title text parameters -->
                    <h4 class="fw-bold m-0"><i class="bi bi-person-check-fill me-2"></i>ABD - New Member Registration & Intake Ledger</h4>
                    <p class="text-muted m-0 small">
                        Event: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Title) | 
                        Date: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Date.ToString("yyyy-MM-dd")) |
                        Welcome to the club!  Please print information clearly.
                    </p>
                    <p class="text-muted m-0 small">
                       <!-- 🌟 DYNAMIC RENEWAL FEE: Pulls straight out of your local appsettings configurations matrix -->
                        <strong>Member Fee: @(Model.IsGeneric ? "$________" : Model.ConfiguredRenewalFee)</strong>
                    </p>
               </div>

                <table class="table table-bordered table-sm align-middle">
                    <thead>
                        <tr>
                                                       <th style="width: 40px;">No.</th>
                            <th class="checkbox-cell">Join</th>
                            <th>Full Name (Please Print Clearly)</th>
                            <th>Email Address</th>
                            <th style="width: 150px;">Phone Number</th>
                            <th class="checkbox-cell">Cash</th>
                            <th class="checkbox-cell">Card</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 1; i < 21; i++)
                        {
                            <tr style="height: 38px;">
                                <td class="text-center text-muted font-monospace bg-light" style="font-size: 10px;">@i</td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @* End Manifest 4 *@

        @* ==========================================
           MANIFEST 5: NON-MEMBER / GUEST SIGN-IN
           ========================================== *@
        @if (Model.SelectedForms.Contains("non-member"))
        {
            <div class="print-page">
                               <div class="border-bottom pb-2 mb-3">
                    <!-- 🌟 UPDATED: Refactored title text parameters -->
                    <h4 class="fw-bold m-0"><i class="bi bi-person-check-fill me-2"></i>ABD - Non-Member Guest Sign-In Ledger</h4>
                    <p class="text-muted m-0 small">
                        Event: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Title) | 
                        Date: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Date.ToString("yyyy-MM-dd")) 
                        Please print your email to receive schedule newsletters.
                    </p>
                    <p class="text-muted m-0 small">
                       <!-- 🌟 DYNAMIC RENEWAL FEE: Pulls straight out of your local appsettings configurations matrix -->
                        <strong>Adminssion Fee: @(Model.IsGeneric ? "$________" : Model.ConfiguredNonMemberFee)</strong>
                        </p>
               </div>
                <table class="table table-bordered table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">No.</th>
                            <th>Printed Full Name</th>
                            <th>Newsletter Subscription: Email Address</th>
                            <th class="checkbox-cell">Cash</th>
                            <th class="checkbox-cell">Card</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 1; i <= 40; i++)
                        {
                            <tr style="height: 35px;">
                                <td class="text-center text-muted font-monospace bg-light" style="font-size: 10px;">@i</td>
                                <td></td>
                                <td></td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* End Manifest 5 *@

           @* ==========================================
           MANIFEST 6: NON-MEMBER-STUDENT / GUEST SIGN-IN
           ========================================== *@
        @if (Model.SelectedForms.Contains("non-member-student"))
        {
            <div class="print-page">
               <div class="border-bottom pb-2 mb-3">
                    <!-- 🌟 UPDATED: Refactored title text parameters -->
                    <h4 
                        class="fw-bold m-0">
                        <i class="bi bi-person-check-fill me-2"></i>ABD - Student Guest Sign-In Ledger</h4>
                    <p class="text-muted m-0 small">
                        Event: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Title) | 
                        Date: @(Model.IsGeneric ? "___________________________" : Model.TargetDance?.Date.ToString("yyyy-MM-dd")) 
                        Please print your email to receive schedule newsletters.
                    </p>
                    <p class="text-muted m-0 small">
                       <!-- 🌟 DYNAMIC RENEWAL FEE: Pulls straight out of your local appsettings configurations matrix -->
                        <strong>Adminssion Fee: @(Model.IsGeneric ? "$________" : Model.ConfiguredStudentNonMemberFee)</strong>
                        </p>
               </div>
                <table class="table table-bordered table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;">No.</th>
                            <th>Printed Full Name</th>
                            <th>Student Id</th>
                            <th>Newsletter Subscription: Email Address</th>
                            <th class="checkbox-cell">Cash</th>
                            <th class="checkbox-cell">Card</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 1; i <= 18; i++)
                        {
                            <tr style="height: 35px;">
                                <td class="text-center text-muted font-monospace bg-light" style="font-size: 10px;">@i</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                                <td class="text-center"><span class="checkbox-square"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* End Manifest 6 *@
    </div> <!-- Close of main container-fluid markup layer -->

    <script>
            window.addEventListener('DOMContentLoaded', () => {
                // Marginally delay dispatching to confirm structural painting processes wrap up
                setTimeout(() => {
                    window.print();
                }, 500);
            });
    </script>
</body>
</html>
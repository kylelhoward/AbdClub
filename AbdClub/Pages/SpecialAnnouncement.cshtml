@page "/SpecialAnnouncement"
@model AbdClub.Pages.SpecialAnnouncementModel
@{
    ViewData["Title"] = Model.AnnouncementTitle ?? "Special Announcement";
}

<div class="container py-4" style="max-width: 1100px;">
    @if (!Model.HasAnnouncement)
    {
        <div class="text-center py-5">
            <i class="bi bi-megaphone display-3 text-muted" aria-hidden="true"></i>
            <h1 class="h2 mt-3">No special announcement right now</h1>
            <p class="text-muted">Please check back later or view our regular announcements.</p>
            <a asp-page="/Announcements" class="btn btn-outline-danger">View announcements</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3 flex-wrap">
            <h1 class="h2 mb-0">@(Model.AnnouncementTitle ?? "Special Announcement")</h1>
            <div class="d-flex gap-2">
                <a asp-page-handler="File" target="_blank" rel="noopener" class="btn btn-outline-secondary">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open
                </a>
                <a asp-page-handler="Download" class="btn btn-danger">
                    <i class="bi bi-download" aria-hidden="true"></i> Download
                </a>
            </div>
        </div>

        @if (Model.IsPdf)
        {
            <div class="ratio border rounded shadow-sm bg-light" style="--bs-aspect-ratio: 125%;">
                <iframe src="@Url.Page("/SpecialAnnouncement", "File")"
                        title="@(Model.AnnouncementTitle ?? "Special announcement")"></iframe>
            </div>
            <p class="text-muted small mt-2">If the PDF does not appear on your phone, use the Open button above.</p>
        }
        else
        {
            <div class="text-center border rounded shadow-sm bg-light p-2">
                <img src="@Url.Page("/SpecialAnnouncement", "File")"
                     alt="@(Model.AnnouncementTitle ?? "Special announcement")"
                     class="img-fluid" style="max-height: 85vh;" />
            </div>
        }
    }
</div>

@page "{id:int}"
@model AbdClub.Pages.Officers.Members.EditMemberModel

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title h4 mb-0">Edit Member</h2>
        </div>
        <div class="card-body">

            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" novalidate>
                <input type="hidden" asp-for="Member.Id" />

                <div class="mb-3">
                    <label asp-for="Member.FirstName" class="form-label">First Name</label>
                    <input asp-for="Member.FirstName" class="form-control" placeholder="Enter first name" />
                    <span asp-validation-for="Member.FirstName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.MiddleName" class="form-label">Middle Name</label>
                    <input asp-for="Member.MiddleName" class="form-control" placeholder="Enter middle name" />
                    <span asp-validation-for="Member.MiddleName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.LastName" class="form-label">Last Name</label>
                    <input asp-for="Member.LastName" class="form-control" placeholder="Enter last name" />
                    <span asp-validation-for="Member.LastName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.Email" class="form-label">Email Address</label>
                    <input asp-for="Member.Email" type="email" class="form-control" placeholder="name@example.com" />
                    <span asp-validation-for="Member.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Member.Phone" class="form-label">Phone</label>
                    <input asp-for="Member.Phone" type="tel" class="form-control"
                           placeholder="512-555-0100" />
                </div>
                <div class="mb-3">
                    <label asp-for="Member.ExpiryDate" class="form-label">Expiry Date</label>
                    <input asp-for="Member.ExpiryDate" type="date" class="form-control" />
                    <span asp-validation-for="Member.ExpiryDate" class="text-danger small"></span>
                </div>

                <div class="card bg-light p-3 mb-4">
                    <div class="container">
                        <div class="row">
                        <div class="col">
                            <div class="form-check form-switch mb-2">
                                <input 
                                    asp-for="Member.IsSuspended" 
                                    type="checkbox" 
                                    class="form-check-input" 
                                    role="switch" />
                                <label asp-for="Member.IsSuspended" class="form-check-label fw-bold">Suspend Member</label>
                            </div>
                            <div class="form-check form-switch">
                                <input 
                                    asp-for="Member.IsOfficer" 
                                    type="checkbox" 
                                    class="form-check-input" 
                                    role="switch" 
                                    id="isOfficerToggle" />
                                <label asp-for="Member.IsOfficer" class="form-check-label fw-bold">Is Officer</label>
                            </div>
                    <div id="officerRoleField" style="display:none;">
                        <label asp-for="Member.OfficerRole" class="form-label mt-2">
                            Officer Role
                        </label>
                        <input asp-for="Member.OfficerRole" class="form-control"
                               placeholder="e.g. President, Treasurer, Secretary" />
                    <span asp-validation-for="Member.OfficerRole" class="text-danger small"></span>
                    </div>
                        </div>
                        <div class="col">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="Member.IsAdmin" type="checkbox" class="form-check-input" role="switch" />
                                <label asp-for="Member.IsAdmin" class="form-check-label fw-bold">Is Admin</label>
                            </div>
                                @if (Model.Member.IsTechAdmin)
                                {
                                        <div class="form-check form-switch">
                                            <input asp-for="Member.IsTechAdmin" type="checkbox" class="form-check-input" role="switch" />
                                            <label asp-for="Member.IsTechAdmin" class="form-check-label fw-bold">Is Tech Admin</label>
                                        </div>
                                }
                       </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    <a asp-page="./MembersList" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                </div>
            </form>
            @if (Model.Payments.Any())
            {
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Payment History</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Period</th>
                                    <th>Transaction</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Payments)
                                {
                                    <tr>
                                        <td>@p.PaymentDate.ToString("MMM d, yyyy")</td>
                                        <td>$@p.Amount.ToString("F2")</td>
                                        <td>
                                            @p.PeriodStart.ToString("MMM d, yyyy") —
                                            @p.PeriodEnd.ToString("MMM d, yyyy")
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @p.TransactionId?[..12]...
                                            </small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show/hide officer role field based on toggle
        const toggle = document.getElementById('isOfficerToggle');
        const roleField = document.getElementById('officerRoleField');

        function updateRoleField() {
            roleField.style.display = toggle.checked ? 'block' : 'none';
        }

        toggle.addEventListener('change', updateRoleField);
        updateRoleField();
    </script>
}
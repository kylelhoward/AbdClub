@page
@model AbdClub.Pages.Officers.SpecialAnnouncement.EditModel
@{
    ViewData["Title"] = "Special Announcement";
}

<div class="container py-4" style="max-width: 760px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Special Announcement</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="h2 fw-bold mb-1">Special Announcement</h1>
            <p class="text-muted mb-0">Upload a completed PDF or image for the public announcement page.</p>
        </div>
        @if (Model.HasExistingFile && Model.Input.IsPublished)
        {
            <a asp-page="/SpecialAnnouncement" target="_blank" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View announcement
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i> Announcement file
            </div>
            <div class="card-body p-4">
                @if (Model.HasExistingFile)
                {
                    <div class="alert alert-light border">
                        <strong>Current file:</strong> @Model.ExistingFileName
                        @if (Model.ExistingUploadedAt.HasValue)
                        {
                            <span class="text-muted"> — uploaded @Model.ExistingUploadedAt.Value.ToLocalTime().ToString("g")</span>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label fw-bold"></label>
                    <input asp-for="Input.Title" class="form-control" placeholder="Optional announcement title" />
                    <span asp-validation-for="Input.Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.File" class="form-label fw-bold"></label>
                    <input asp-for="Input.File" class="form-control" type="file"
                           accept="application/pdf,image/jpeg,image/png,image/webp" />
                    <div class="form-text">
                        PDF, JPG, PNG, or WebP; maximum 10 MB.
                        @if (Model.HasExistingFile)
                        {
                            <span>Leave blank to keep the current file.</span>
                        }
                    </div>
                    <span asp-validation-for="Input.File" class="text-danger"></span>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="Input.IsPublished" class="form-check-input" />
                    <label asp-for="Input.IsPublished" class="form-check-label fw-bold"></label>
                    <div class="form-text">When published, a Special Announcement link appears in the public navigation.</div>
                </div>
            </div>
        </section>

        <div class="d-flex justify-content-between gap-2 flex-wrap">
            <div>
                @if (Model.HasExistingFile)
                {
                    <button type="submit" asp-page-handler="Remove" class="btn btn-outline-danger"
                            onclick="return confirm('Remove the special announcement and its uploaded file?');">
                        <i class="bi bi-trash" aria-hidden="true"></i> Remove
                    </button>
                }
            </div>
            <div class="d-flex gap-2">
                <a asp-page="/Officers/Dashboard" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-check-circle" aria-hidden="true"></i> Save
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

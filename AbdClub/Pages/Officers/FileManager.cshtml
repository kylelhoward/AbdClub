@page
@using AbdClub.Enums
@model AbdClub.Pages.Officers.FileManagerModel
@{
    ViewData["Title"] = "Club File Manager";

    // Extract current user details for UI comparison
    var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(userIdClaim, out int currentUserId);

    // Evaluate the Officer condition for the frontend view
    bool canDeleteAsOfficer = User.IsInRole("Officer") &&
                              User.FindFirst("OfficerRole")?.Value == "Tech Sergeant Chen";
}

<h3>Upload Club File</h3>

<!-- Display any validation errors (e.g., wrong file extension) -->
<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" enctype="multipart/form-data">
    @{
        // Extract the genuine database Primary Key ID of the logged-in member
        var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    <!-- Feed the real ID dynamically into your form -->
    <input type="hidden" asp-for="UploadData.UploadedByMemberId" value="@userIdClaim" />


    <div class="mb-3">
        <label class="form-label">Select File</label>
        <input type="file" name="FormFile" class="form-control" accept=".pdf,.docx, .txt,.docx,.xls,.xlsx,.pptx,.html,.csv" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="UploadData.Category" class="form-select"
                asp-items="Html.GetEnumSelectList<FileCategory>()" required>
            <option value="">-- Select Category --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Upload & Save</button>
</form>

<hr />

<h3>Club Documents</h3>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Uploaded By</th> <!-- New Column -->
            <th>Uploaded At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var file in Model.SavedClubFiles)
        {
            <tr>
                <td>@file.FileName</td>
                <td><span class="badge bg-secondary">@file.Category.ToString()</span></td>

                <!-- Display the member's name securely -->
                <td>
                    @if (file.UploadedBy != null)
                    {
                        @($"{file.UploadedBy.FullName}: {file.UploadedBy.Email}")
                    }
                    else
                    {
                        <span class="text-muted">Unknown Member</span>
                    }
                </td>

                <td>@file.UploadedAt.ToLocalTime().ToString("g")</td>
                <td>
                    <a asp-page-handler="Download" asp-route-id="@file.Id" class="btn btn-sm btn-success">Download</a>

                    @if (file.UploadedByMemberId == currentUserId || canDeleteAsOfficer)
                    {
                        <form method="post" asp-page-handler="Delete" asp-route-id="@file.Id" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this file?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@page
@model AbdClub.Pages.Officers.Members.AddMemberModel
@{
    ViewData["Title"] = "Add Member";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h2 class="card-title h4 mb-0">Add New Member</h2>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post" novalidate>

                <div class="mb-3">
                    <label asp-for="Member.FirstName" class="form-label">First Name</label>
                    <input asp-for="Member.FirstName" class="form-control" />
                    <span asp-validation-for="Member.FirstName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.MiddleName" class="form-label">Middle Name</label>
                    <input asp-for="Member.MiddleName" class="form-control" />
                    <span asp-validation-for="Member.MiddleName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.LastName" class="form-label">Last Name</label>
                    <input asp-for="Member.LastName" class="form-control" />
                    <span asp-validation-for="Member.LastName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.Email" class="form-label">
                        Email Address
                        <small class="text-muted">(used to log in)</small>
                    </label>
                    <input asp-for="Member.Email" type="email" class="form-control"
                           placeholder="jane@example.com" />
                    <span asp-validation-for="Member.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.Phone" class="form-label">
                        Phone <small class="text-muted">(optional)</small>
                    </label>
                    <input asp-for="Member.Phone" type="tel" class="form-control"
                           placeholder="512-555-0100" />
                </div>

                <div class="mb-3">
                    <label asp-for="Member.JoinDate" class="form-label">Join Date</label>
                    <input asp-for="Member.JoinDate" type="date" class="form-control"
                           value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Member.JoinDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Member.ExpiryDate" class="form-label">Expiry Date</label>
                    <input asp-for="Member.ExpiryDate" type="date" class="form-control"
                           value="@DateTime.UtcNow.AddYears(1).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Member.ExpiryDate" class="text-danger small"></span>
                </div>

                <div class="card bg-light p-3 mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="Member.IsSuspended" type="checkbox" class="form-check-input" role="switch" />
                        <label asp-for="Member.IsSuspended" class="form-check-label fw-bold">Suspend membership</label>
                    </div>
                    <div class="form-text">Officer login permissions are managed separately under Admin → Officer Accounts.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Record a payment?
                        <small class="text-muted fw-normal">
                            (for members paying by check or cash)
                        </small>
                    </label>
                    <div class="form-check form-switch">
                       <!-- 🌟 APPROACH A: Use the formal Tag Helper (Highly Recommended) -->
<input type="checkbox" class="form-check-input" role="switch" asp-for="RecordPayment" id="recordPayment" />

                        <label class="form-check-label" for="RecordPayment">
                            Record $50 payment
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    <a asp-page="./MembersList" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        Add Member
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

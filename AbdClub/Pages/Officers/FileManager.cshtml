@page
@using AbdClub.Enums
@model AbdClub.Pages.Officers.FileManagerModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService 
@* 🌟 FIXED: Explicitly injected the service with its correct PascalCase variable name *@
@{
    ViewData["Title"] = "Club File Manager";

    // FIXED: Changed from NameIdentifier to your custom MemberId claim to match your integer parsing rules
    var userIdClaim = User.FindFirst("MemberId")?.Value;
    int.TryParse(userIdClaim, out int currentUserId);

    // FIXED: Evaluated using the freshly injected, capitalized AuthorizationService instance
    var authResult = await AuthorizationService.AuthorizeAsync(User, null, "isAdmin");
    bool canDeleteAsOfficer = authResult.Succeeded;
}

<h3>Upload Club File</h3>
<!-- Breadcrumb Routing Consistency -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">File Manager</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-mailbox2 me-2"></i>Upload Club File</h2>
        <p class="text-muted mb-0">Manage club files.</p>
    </div>
    <div class="card bg-primary text-white border-0 shadow-sm px-4 py-2">
        <div class="small">File Count Total</div>
        <div class="fs-4 fw-bold text-center">@Model.SavedClubFiles.Count()</div>
    </div>
</div>

<!-- Display any validation errors (e.g., wrong file extension) -->
<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" enctype="multipart/form-data">
    @{
        // Extract the genuine database Primary Key ID of the logged-in member
        var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    <!-- Feed the real ID dynamically into your form -->
    <input type="hidden" asp-for="UploadData.UploadedByMemberId" value="@userIdClaim" />


    <div class="mb-3">
        <label class="form-label">Select File</label>
        <input type="file" name="FormFile" class="form-control" accept=".pdf,.docx, .txt,.docx,.xls,.xlsx,.pptx,.html,.csv" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="UploadData.Category" class="form-select"
                asp-items="Html.GetEnumSelectList<FileCategory>()" required>
            <option value="">-- Select Category --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Upload & Save</button>
</form>

<hr />

<h3>Club Documents</h3>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Uploaded By</th> <!-- New Column -->
            <th>Uploaded At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var file in Model.SavedClubFiles)
        {
            <tr>
                <td>@file.FileName</td>
                <td><span class="badge bg-secondary">@file.Category.ToString()</span></td>

                <!-- Display the member's name securely -->
                <td>
                    @if (file.UploadedBy != null)
                    {
                        @($"{file.UploadedBy.FullName}: {file.UploadedBy.Email}")
                    }
                    else
                    {
                        <span class="text-muted">Unknown Member</span>
                    }
                </td>

                <td>@file.UploadedAt.ToLocalTime().ToString("g")</td>
                <td>
                    <a asp-page-handler="Download" asp-route-id="@file.Id" class="btn btn-sm btn-success">Download</a>

                    @if (file.UploadedByMemberId == currentUserId || canDeleteAsOfficer)
                    {
                        <form method="post" asp-page-handler="Delete" asp-route-id="@file.Id" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this file?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

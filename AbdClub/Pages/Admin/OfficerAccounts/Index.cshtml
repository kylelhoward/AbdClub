@page
@model AbdClub.Pages.Admin.OfficerAccounts.IndexModel
@{
    ViewData["Title"] = "Officer Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1>Officer Accounts</h1><p class="text-muted mb-0">Manage website login access separately from membership.</p></div>
    <a asp-page="Edit" class="btn btn-primary">Add officer account</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Email</th><th>Linked member</th><th>Access</th><th>Title</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var account in Model.Accounts)
        {
            <tr>
                <td>@account.Email</td>
                <td>@(account.Member?.FullName ?? "Not linked")</td>
                <td>@account.AccessLevel</td>
                <td>@account.OfficerTitle</td>
                <td><span class="badge @(account.IsEnabled ? "bg-success" : "bg-secondary")">@(account.IsEnabled ? "Enabled" : "Disabled")</span></td>
                <td class="text-end"><a asp-page="Edit" asp-route-id="@account.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

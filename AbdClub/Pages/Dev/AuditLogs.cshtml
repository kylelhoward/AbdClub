@page
@model AbdClub.Pages.Dev.AuditLogsModel
@{
    ViewData["Title"] = "Executive System Audit Ledger";
}

<div class="container mt-4" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2><i class="bi bi-shield-shaded text-dark me-2"></i>System Operational Ledger</h2>
            <p class="text-muted mb-0">Review real-time application events, track security access records, and verify webhook transaction handshakes.</p>
        </div>

        <!-- Severity Level Filtration Tool Form Component -->
        <form method="get" class="d-flex gap-2">
            <select asp-for="SelectedLevel" class="form-select form-select-sm" style="width: 180px;" onchange="this.form.submit()">
                <option value="">-- All Severities --</option>
                <option value="Information">Information</option>
                <option value="Warning">Warnings Only</option>
                <option value="Error">Errors Only</option>
                <option value="Fatal">Fatal System Exceptions</option>
            </select>
            @if (!string.IsNullOrEmpty(Model.SelectedLevel))
            {
                <a asp-page="./AuditLogs" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </form>
    </div>

    <!-- MAIN EVENT TRACKING CONTAINER TABLE -->
    <div class="card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-dark text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-3" style="width: 180px;">Timestamp (UTC)</th>
                        <th style="width: 120px;">Severity</th>
                        <th>Event Message / Trace Context</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs != null && Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            var badgeClass = log.Level == "Fatal" ? "bg-danger" :
                                             log.Level == "Error" ? "bg-danger bg-opacity-75" :
                                             log.Level == "Warning" ? "bg-warning text-dark" : "bg-light text-secondary border";
                            <tr>
                                <td class="ps-3 text-muted font-monospace">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <span class="badge @badgeClass shadow-sm d-inline-block text-center py-1" style="width: 90px;">@log.Level</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark mb-1">@log.Message</div>

                                    @if (!string.IsNullOrEmpty(log.Exception))
                                    {
                                        <!-- Collapsible Error Stack Trace Layout Block -->
                                        <div class="mt-1">
                                            <!-- 🌟 FIXED: Links target tags cleanly using our virtual row count ID numbers -->
                                            <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none font-monospace" style="font-size: 0.75rem;" type="button" data-bs-toggle="collapse" data-bs-target="#err_row_@log.Id">
                                                <i class="bi bi-bug-fill me-1"></i>Expose Complete Exception Stack Trace...
                                            </button>
                                            <div class="collapse mt-1" id="err_row_@log.Id">
                                                <pre class="bg-danger bg-opacity-10 text-danger p-3 rounded border border-danger border-opacity-20 font-monospace small" style="white-space: pre-wrap; max-height: 200px; overflow-y: auto;">@log.Exception</pre>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center p-5 text-muted italic">
                                <i class="bi bi-folder-x fs-3 d-block mb-2 opacity-50"></i>No system logs recorded matching your filtration boundaries.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION WORKSPACE LINKS FOOTER CONTROLS -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Audit Log Pagination">
            <ul class="pagination pagination-sm justify-content-center shadow-sm d-inline-flex border rounded">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-item link-dark page-link" asp-page="./AuditLogs" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-SelectedLevel="@Model.SelectedLevel">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active bg-dark border-dark text-white" : "")">
                        <a class="page-link @(Model.CurrentPage == i ? "bg-dark text-white border-dark" : "text-dark")" asp-page="./AuditLogs" asp-route-CurrentPage="@i" asp-route-SelectedLevel="@Model.SelectedLevel">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-item link-dark page-link" asp-page="./AuditLogs" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-SelectedLevel="@Model.SelectedLevel">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>


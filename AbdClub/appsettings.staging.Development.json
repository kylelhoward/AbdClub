{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },


  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        // 🌟 THE FIX: Silence all noisy Level 0 (Verbose) and Level 1 (Debug) framework routing logs
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Host=localhost;Database=abdclub_dev;Username=abdadmin;Password=Adm1n001",
          "tableName": "Logs", // 🌟 GENERIC: Built-in standard Serilog table
          "needAutoCreateTable": true, // Automatically constructs the table schema on boot
          "period": "00:00:01", // Flushes logs instantly every 1 second
          "respectCase": true, // 🌟 CRITICAL: Tells Serilog to enforce standard uppercase "Logs" tracking names
          "useCopy": false,
          // 🌟 THE FILTER FIX: Explicitly blocks this specific database table 
          // from saving anything below Level 2 (Information). 
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },

  // 🌟 NEW CONFIGURATION VARIABLES LAYER: Centrally manage global fee parameters

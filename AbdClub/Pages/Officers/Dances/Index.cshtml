@page
@model AbdClub.Pages.Officers.Dances.IndexModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Manage Club Dances";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
                <!-- Breadcrumb Routing Consistency -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dance List</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
        <h2><i class="bi bi-calendar-event me-2"></i>Official Dance Matrix</h2>
                <p class="text-muted mb-0">Manage club members and their statuses</p>
            </div>
           
        </div>
         @if ((await AuthorizationService.AuthorizeAsync(User, null, "isAdmin")).Succeeded)
        {
            @* CREATION_INPUT_MODAL  *@
            <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#createDanceModal">
                <i class="bi bi-plus-circle me-2"></i>Create New Dance
            </button>
        }
    </div>

    @if (Model.UpdateFeedback != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.UpdateFeedback
            <button type="button" class="btn-close" data-bs-alert data-bs-dismiss="alert"></button>
        </div>
    }

    @* ------------ Begin DanceList -------------- *@
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Scheduled Date</th>
                        <th>Dance Event Title</th>
                        <th>Location Venue</th>
                        <th>Time Window</th>
                        <th>Assigned DJ</th>
                        @* ActionControls *@
                        <th class="pe-3 text-end">Action Controls</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UpcomingDances.Any())
                    {
                        foreach (var dance in Model.UpcomingDances)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@dance.Date.ToString("ddd, MMM dd, yyyy")</td>
                                <td>
                                    <span class="d-block fw-semibold text-primary">@dance.Title</span>
                                </td>
                               <!-- 🌟 THE REUSABLE TRIGGER COMPONENT LAYOUT BLOCK -->
                                <td>
                                    <button type="button" 
                                            class="btn btn-link text-primary p-0 fw-semibold text-decoration-none text-start venue-modal-trigger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#venueDetailModal"
                                            data-name="@dance.Location.VenueName"
                                            data-address="@dance.Location.Address"
                                            data-desc="@(dance.Location.Description ?? "No specialized entrance codes or arrival rules cataloged.")"
                                            data-map="@(dance.Location.GoogleMapsUrl ?? "")"
                                            data-photo="@(dance.Location.PhotoUrl ?? "")">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@dance.Location.VenueName
                                    </button>
                                </td>

                                <td><span class="badge bg-secondary">@dance.StartTime.ToString("h:mm tt") - @dance.EndTime.ToString("h:mm tt")</span></td>
                                <td>@(dance.AssignedDj != null ? dance.AssignedDj.Name : "Unassigned")</td>

                                @* ActionControls *@
                                <td class="pe-3 text-end">
                                    <div class="btn-group gap-1">
                                       @* Navigation trigger jump to attendance panel management layers *@
                                        <a class="btn btn-sm btn-outline-success" asp-page="./AttendingOfficers" asp-route-id="@dance.Id">
                                            <i class="bi bi-shield-check"></i> Officer Attendance
                                        </a>
                                       @* PrintRosters *@
                                        <button type="button" 
                                            class="btn btn-sm btn-outline-dark" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#printManifestModal"
                                            data-dance-id="@dance.Id"
                                            data-dance-title="@dance.Title"
                                            data-dance-meta="@dance.Date.ToString("ddd, MMM dd, yyyy") at @dance.Location.VenueName">
                                            <i class="bi bi-printer-fill me-1"></i> Print Roster Sheets
                                        </button>
                                       @* Edit/View *@
        @if (User.IsInRole("Admin") || User.IsInRole("TechAdmin"))
        {
            <a class="btn btn-sm btn-outline-dark" asp-page="./Edit" asp-route-id="@dance.Id">
                <i class="bi bi-pencil-square me-1"></i>Edit
            </a>
            
            <!-- 🌟 NEW DELETE TRIGGER BUTTON: Restricted strictly to top-level executives -->
            <button type="button" 
                    class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal" 
                    data-bs-target="#deleteDanceConfirmationModal"
                    data-dance-id="@dance.Id"
                    data-dance-title="@dance.Title">
                <i class="bi bi-trash-fill"></i>
            </button>
        }
        else
        {
            <a class="btn btn-sm btn-outline-secondary" asp-page="./Edit" asp-route-id="@dance.Id">
                <i class="bi bi-eye-fill me-1"></i>View
            </a>
        }                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-muted">No scheduled dances exist within your database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
     <!-- Render the reusable venue popup partial view shell at the bottom of the root wrapper -->
    <partial name="_VenueDetailModal" />
</div>
@*  --------- End DanceList ------------------------ *@

@* ----------- Begin Modals ------------------ *@

@* ------- Begin PrintRosters MODAL ---------------------------------------- *@
<div class="modal fade" id="printManifestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-3 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-pdf-fill text-warning me-2"></i>Event Logistics Print Dispatcher</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                
                <!-- Target Header Focus Meta Block -->
                <div class="bg-light p-3 rounded-3 border border-light-subtle mb-3">
                    <div class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.7rem;">Target Profile Context</div>
                    <h5 id="printTargetTitle" class="fw-bold text-dark mb-1"></h5>
                    <small id="printTargetMeta" class="text-secondary font-monospace"></small>
                </div>

                <!-- Global Style Control Switches -->
                <div class="row g-2 mb-4 border-bottom pb-3">
                    <div class="col-6">
                        <div class="form-check form-switch card p-2 bg-light border-0 shadow-sm mb-0">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="chkUseGenericLayout">
                            <label class="form-check-label small fw-bold text-dark" for="chkUseGenericLayout">Generic Form (Blanks)</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch card p-2 bg-light border-0 shadow-sm mb-0">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="chkSelectAllForms" onchange="toggleSelectAllManifestForms(this)">
                            <label class="form-check-label small fw-bold text-dark" for="chkSelectAllForms">Select All Manifests</label>
                        </div>
                    </div>
                </div>

                <!-- Manifest Checklist Selection Blocks -->
                <h6 class="fw-bold text-muted small text-uppercase mb-2">Select Roster Manifests to Include:</h6>
                <div class="d-flex flex-column gap-2" id="manifestFormCheckboxGroup">
                    
                    <div class="form-check card p-2.5 border border-light-subtle hover-shadow mb-0">
                        <input class="form-check-input ms-1 me-3 manifest-print-item" type="checkbox" value="active-members" id="formActive">
                        <label class="form-check-label small fw-bold text-dark text-start" for="formActive">Active Members Check-In Sheet</label>
                    </div>
                    
                    <div class="form-check card p-2.5 border border-light-subtle hover-shadow mb-0">
                        <input class="form-check-input ms-1 me-3 manifest-print-item" type="checkbox" value="inactive-members" id="formInactive">
                        <label class="form-check-label small fw-bold text-dark text-start" for="formInactive">Inactive Members Registry (Lapsed Lookup)</label>
                    </div>
                    
                    <div class="form-check card p-2.5 border border-light-subtle hover-shadow mb-0">
                        <input class="form-check-input ms-1 me-3 manifest-print-item" type="checkbox" value="duty-log" id="formDuty">
                        <label class="form-check-label small fw-bold text-dark text-start" for="formDuty">Event Duty Log (Officers, Hosts, DJs, Instructors)</label>
                    </div>
                    
                    <div class="form-check card p-2.5 border border-light-subtle hover-shadow mb-0">
                        <input class="form-check-input ms-1 me-3 manifest-print-item" type="checkbox" value="new-signup" id="formNew">
                        <label class="form-check-label small fw-bold text-dark text-start" for="formNew">New Member Sign-Up Intake Ledger</label>
                    </div>
                    
                    <div class="form-check card p-2.5 border border-light-subtle hover-shadow mb-0">
                        <input class="form-check-input ms-1 me-3 manifest-print-item" type="checkbox" value="non-member" id="formNonMember">
                        <label class="form-check-label small fw-bold text-dark text-start" for="formNonMember">Non-Member / Guest Sign-In Ledger</label>
                    </div>

                    <div class="form-check card p-2.5 border border-light-subtle hover-shadow mb-0">
                        <input class="form-check-input ms-1 me-3 manifest-print-item" type="checkbox" value="non-member-student" id="formNonMember">
                        <label class="form-check-label small fw-bold text-dark text-start" for="formNonMember">Student Non-Member / Guest Sign-In Ledger</label>
                    </div>

                </div>
            </div>
            <div class="modal-footer bg-light p-3 border-0">
                <button type="button" class="btn btn-secondary py-2 flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-dark py-2 flex-grow-1 fw-bold shadow" onclick="executeManifestPrintStream()">
                    <i class="bi bi-printer-fill me-1 text-warning"></i>Generate & Print
                </button>
            </div>
        </div>
    </div>
</div>

@* ------- End PrintRosters MODAL ---------------------------------------- *@

@* ------- Begin CREATION_INPUT_MODAL ---------------------------------------- *@
<div class="modal fade" id="createDanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">

        <!--
            CRITICAL FIX: Outer single quotes protect inner JSON formatting keys.
            We initialize an empty array since a brand new dance starts with zero lessons.
        -->
        <form method="post" asp-page-handler="CreateDance" class="modal-content shadow-lg border-0"
              x-data='{
            lessons: [],
            addLesson() {
            this.lessons.push({ instructorid: 0, type: "", startTime: "19:00:00", endTime: "20:00:00" });
            },
            removeLesson(index) {
            this.lessons.splice(index, 1);
            }
            }'>

        
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-calendar-plus me-2"></i>Schedule Registry Dance Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">

            <!-- Section 1: Core Event Fields -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted mb-1">Dance Title</label>
                    <input asp-for="FormInput.Title" class="form-control" placeholder="e.g., Summer Retro Swing Gala" required />
                    <span asp-validation-for="FormInput.Title" class="text-danger small"></span>
                </div>
                
                <!-- 🌟 REFACTORED DROPDOWN: Replaces the raw location text box -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted mb-1">Location / Venue Room</label>
                    <select asp-for="FormInput.SelectedLocationId" class="form-select bg-light fw-medium" required>
                        <option value="">-- Choose Registered Club Venue --</option>
                        @foreach (var loc in Model.AvailableLocations)
                        {
                            <option value="@loc.Id">@loc.VenueName (@loc.Address)</option>
                        }
                    </select>
                    <span asp-validation-for="FormInput.SelectedLocationId" class="text-danger small"></span>
                </div>
            </div>


                <!-- Section 2: Date and Time Operations Configurations -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted mb-1">Scheduled Event Date</label>
                        <input asp-for="FormInput.Date" type="date" class="form-control" required />
                        <span asp-validation-for="FormInput.Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted mb-1">Start Time</label>
                        <input asp-for="FormInput.StartTime" type="time" class="form-control" required />
                        <span asp-validation-for="FormInput.StartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted mb-1">End Time</label>
                        <input asp-for="FormInput.EndTime" type="time" class="form-control" required />
                        <span asp-validation-for="FormInput.EndTime" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Section 3: Contact & Descriptive Metadata Elements -->
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-bold small text-muted mb-1">Public Coordination Contact Email</label>
                        <input asp-for="FormInput.ContactEmail" type="email" class="form-control" placeholder="management@abdclub.com" />
                        <span asp-validation-for="FormInput.ContactEmail" class="text-danger small">Contact Email required</span>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold small text-muted mb-1">Public Description / Calendar Announcements</label>
                        <textarea asp-for="FormInput.Description" class="form-control" rows="2" placeholder="Add specific open schedules, pricing, dress code restrictions..."></textarea>
                        <span asp-validation-for="FormInput.Description" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4 border-light-subtle" />

                <!-- Section 4: Single-Select Master DJ Lookup Directory -->
                <div class="mb-4">
                    <label class="form-label fw-bold small text-primary mb-1"><i class="bi bi-disc-fill me-1"></i>Select Event DJ Assignment</label>
                    <select asp-for="FormInput.SelectedDjId" class="form-select bg-light border-primary-subtle fw-medium">
                        <option value="">-- No DJ Assigned / Vacant Position --</option>
                        @foreach (var dj in Model.RegistryDjs)
                        {
                            <option value="@dj.Id">@dj.Name @(!string.IsNullOrEmpty(dj.Notes) ? $"— {dj.Notes}" : "")</option>
                        }
                    </select>
                </div>

                <!-- Section 5: REFACTORED Two-Column Helper Grid System (Removed Static Instructor Box) -->
                <div class="row g-3 mb-4">

                    <!-- Hosts Column -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light h-100 shadow-sm border-light-subtle">
                            <label class="fw-bold small mb-2 text-dark d-block"><i class="bi bi-person-badge-fill text-primary me-1"></i>Dance Hosts</label>
                            <div class="bg-white border rounded p-2" style="max-height: 140px; overflow-y: auto;">
                                @if (Model.RegistryHosts.Any())
                                {
                                    foreach (var host in Model.RegistryHosts)
                                    {
                                        <div class="form-check mb-1">
                                            <input 
                                                class="form-check-input" 
                                                type="checkbox" 
                                                name="FormInput.SelectedHostIds" 
                                                value="@host.Id" 
                                                id="h_@host.Id" />
                                            <label 
                                                class="form-check-label small fw-semibold text-dark" 
                                                for="h_@host.Id">@host.Name</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small italic p-1 d-block">Registry empty</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Volunteers Column -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light h-100 shadow-sm border-light-subtle">
                            <label class="fw-bold small mb-2 text-dark d-block"><i class="bi bi-heart-fill text-danger me-1"></i>Volunteers</label>
                            <div class="bg-white border rounded p-2" style="max-height: 140px; overflow-y: auto;">
                                @if (Model.RegistryVolunteers.Any())
                                {
                                    foreach (var vol in Model.RegistryVolunteers)
                                    {
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox" name="FormInput.SelectedVolunteerIds" value="@vol.Id" id="v_@vol.Id" />
                                            <label class="form-check-label small fw-semibold text-dark" for="v_@vol.Id">@vol.Name</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small italic p-1 d-block">Registry empty</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 6: Many-to-Many Attending Club Officers Checklist -->
                <div class="mb-4">
                    <div class="p-3 border rounded bg-light shadow-sm border-light-subtle">
                        <label class="fw-bold small mb-2 text-dark d-block"><i class="bi bi-shield-lock-fill text-secondary me-1"></i>Assign Duty Roster Officers</label>
                        <div class="bg-white border rounded p-2" style="max-height: 130px; overflow-y: auto;">
                            @if (Model.AvailableOfficers != null && Model.AvailableOfficers.Any())
                            {
                                @foreach (var officer in Model.AvailableOfficers)
                                {
                                    <div class="form-check mb-1">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="FormInput.SelectedOfficerIds"
                                               value="@officer.Id" id="o_@officer.Id" />
                                        <label class="form-check-label small fw-semibold text-dark"
                                               for="o_@officer.Id">@officer.LastName</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted small italic p-1 d-block">No active officers available in system data.</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- DANCE LESSON CONFIGURATION PANEL (1:1 SINGULAR LESSON) -->
<div class="mb-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-secondary text-white p-3">
            <h6 class="mb-0 text-uppercase tracking-wider fw-bold small">
                <i class="bi bi-journal-bookmark-fill me-2"></i>Event Pre-Dance Lesson Details
            </h6>
        </div>

        <div class="card-body p-4 bg-light bg-opacity-25">
            <div class="row g-3">
                <!-- Field 1: Lesson Topic / Style Type -->
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.Type">
                        Lesson Topic / Type
                    </label>
                    <input asp-for="FormInput.AssignedLesson.Type" 
                           type="text" 
                           class="form-control form-control-sm bg-white" 
                           placeholder="e.g., East Coast Swing (Intro)" />
                    <span asp-validation-for="FormInput.AssignedLesson.Type" class="text-danger small font-monospace"></span>
                </div>

                <!-- Field 2: Assigned Instructor -->
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.InstructorId">
                        Instructor Name
                    </label>
                    <select asp-for="FormInput.AssignedLesson.InstructorId" 
                            class="form-select form-select-sm bg-white">
                        <option value="">-- Choose Instructor (Optional) --</option>
                        @foreach (var inst in Model.RegistryInstructors)
                        {
                            <option value="@inst.Id">@inst.Name @(!string.IsNullOrEmpty(inst.Email) ? $"({inst.Email})" : "")</option>
                        }
                    </select>
                    <span asp-validation-for="FormInput.AssignedLesson.InstructorId" class="text-danger small font-monospace"></span>
                </div>

                <!-- Field 3: Start Time -->
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.StartTime">
                        Lesson Start Time
                    </label>
                    <input asp-for="FormInput.AssignedLesson.StartTime" 
                           type="time" 
                           class="form-control form-control-sm bg-white" />
                    <span asp-validation-for="FormInput.AssignedLesson.StartTime" class="text-danger small font-monospace"></span>
                </div>

                <!-- Field 4: End Time -->
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.EndTime">
                        Lesson End Time
                    </label>
                    <input asp-for="FormInput.AssignedLesson.EndTime" 
                           type="time" 
                           class="form-control form-control-sm bg-white" />
                    <span asp-validation-for="FormInput.AssignedLesson.EndTime" class="text-danger small font-monospace"></span>
                </div>
            </div>
            <div class="form-text text-muted mt-2 small">
                Leave these fields blank if this social dance does not include a pre-dance instructional lesson.
            </div>
        </div>
    </div>
</div>


 


            </div>
            <div class="modal-footer bg-light">
                <button 
                    type="button" 
                    class="btn btn-outline-secondary"
                    data-bs-dismiss="modal">Cancel</button>
                <button
                    type="submit" 
                    class="btn btn-primary px-4">Create Master Schedule</button>
            </div>
        </form>
    </div>
</div>
@* ------- End CREATION_INPUT_MODAL ---------------------------------------- *@


@*  --------- 🌟 DELETE_MODAL CONSOLE -- *@

<!-- 🌟 CENTRALIZED DISMISSAL & CASCADE DELETE MODAL CONSOLE -->
<div class="modal fade" id="deleteDanceConfirmationModal" tabindex="-1" aria-labelledby="deleteDanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header bg-danger text-white p-3 border-0">
                <h5 class="modal-title fw-bold" id="deleteDanceModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Event Cancellation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form method="post" asp-page-handler="DeleteDance">
                @Html.AntiForgeryToken() @* 👈 Crucial to bypass validation token blocks *@
                <input type="hidden" id="modalDeleteDanceId" name="id" value="" />
                
                <div class="modal-body p-4 bg-white text-dark text-start">
                    <p class="mb-2">Are you absolutely sure you want to permanently delete this social dance scheduling block?</p>
                    <div class="p-3 bg-light rounded border border-danger border-opacity-25 mb-3">
                        <strong class="text-danger d-block small text-uppercase fw-bold mb-1">Target Event Profile:</strong>
                        <span id="modalDeleteDanceTitle" class="fw-bold fs-5 text-dark">Dance Title Here</span>
                    </div>
                    <small class="text-muted d-block">
                        <i class="bi bi-info-circle me-1"></i><strong>Cascade Notice:</strong> Deleting this item immediately removes any linked 1:1 pre-dance lessons, volunteer shift rosters, and instructor schedules from database memory. This cannot be undone.
                    </small>
                </div>
                
                <div class="modal-footer bg-light p-2 border-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger fw-bold px-4">
                        <i class="bi bi-trash-fill me-1"></i>Permanently Delete Event
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@*  --------- End DELETE_MODAL CONSOLE -- *@


@* ----------- End Modals ------------------ *@

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        //  Begin CREATION_INPUT_MODAL
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('#createDanceModal form');
            const submitBtn = document.getElementById('createDanceSubmitBtn');

            if (form && submitBtn) {
                form.addEventListener('submit', function(e) {
                    // Validate lesson fields: all or nothing
                    const instructorId = document.querySelector('[name="FormInput.AssignedLesson.InstructorId"]');
                    const lessonType = document.querySelector('[name="FormInput.AssignedLesson.Type"]');
                    const startTime = document.querySelector('[name="FormInput.AssignedLesson.StartTime"]');
                    const endTime = document.querySelector('[name="FormInput.AssignedLesson.EndTime"]');

                    if (instructorId && lessonType && startTime && endTime) {
                        const hasInstructor = instructorId.value && parseInt(instructorId.value) > 0;
                        const hasType = lessonType.value && lessonType.value.trim() !== '';
                        const hasStartTime = startTime.value && startTime.value.trim() !== '';
                        const hasEndTime = endTime.value && endTime.value.trim() !== '';

                        const filledCount = [hasInstructor, hasType, hasStartTime, hasEndTime].filter(Boolean).length;

                        // If some but not all fields are filled, prevent submission
                        if (filledCount > 0 && filledCount < 4) {
                            e.preventDefault();
                           alert ('Lesson fields must be completed together. Either fill in all lesson fields (Instructor, Type, Start Time, End Time) or leave them all blank.');
                            return false;
                        }
                    }

                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Scheduling Event & Emailing Officers...';
                });
            }
        });
        //  End CREATION_INPUT_MODAL
 

        // Begin PrintRosters 
        document.addEventListener("DOMContentLoaded", function () {
        var printModal = document.getElementById('printManifestModal');
        if (!printModal) return;

            printModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                // Extract the database-backed tracking values
                var danceId = button.getAttribute('data-dance-id');
                var title = button.getAttribute('data-dance-title');
                var meta = button.getAttribute('data-dance-meta');

                // Hydrate values text content blocks
                document.getElementById('printTargetTitle').textContent = title;
                document.getElementById('printTargetMeta').textContent = meta;
                printModal.setAttribute('data-current-id', danceId);
                });
            });

            function toggleSelectAllManifestForms(masterCheckbox) {
                var items = document.querySelectorAll('.manifest-print-item');
                items.forEach(box => box.checked = masterCheckbox.checked);
            }

            function executeManifestPrintStream() {
                var checkedItems = [];
                document.querySelectorAll('.manifest-print-item:checked').forEach(box => {
                    checkedItems.push(box.value);
                });

                if (checkedItems.length === 0) {
                    alert('Please select at least one manifest tracking sheet type to print.');
                    return;
                }

                var modal = document.getElementById('printManifestModal');
                var danceId = modal.getAttribute('data-current-id');
                var useGeneric = document.getElementById('chkUseGenericLayout').checked;

                // 🌟 ARCHITECTURAL DISPATCH: Redirect to a dedicated print-engine page layout
                // passing checked arrays as standard string delimiters
                var printUrl = `./Dances/PrintManifests?id=${danceId}&forms=${checkedItems.join(',')}&generic=${useGeneric}`;
                
                // Open the document layout inside a temporary browser print view lane container
                var printWindow = window.open(printUrl, '_blank');
                if (printWindow) printWindow.focus();
            }
            // End PrintRosters 

            // Begin DELETE_MODAL 
var deleteModal = document.getElementById('deleteDanceConfirmationModal');
if (deleteModal) {
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        
        // Safely extract parameter variables off current data tags
        var danceId = button.getAttribute('data-dance-id');
        var danceTitle = button.getAttribute('data-dance-title');
        
        // Hydrate target modal form input slots natively
        document.getElementById('modalDeleteDanceId').value = danceId;
        document.getElementById('modalDeleteDanceTitle').textContent = danceTitle;
    });
}

            // End DELETE_MODAL


</script>
}



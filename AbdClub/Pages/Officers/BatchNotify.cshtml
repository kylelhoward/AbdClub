@page
@model AbdClub.Pages.Officers.BatchNotifyModel
@{
    ViewData["Title"] = "Officer Broadcast Center";
}
<!-- Include Alpine.js directly in the head layout context -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>


<div class="container mt-4" style="max-width: 800px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
            <li class="breadcrumb-item active">Member Broadcast</li>
        </ol>
    </nav>

   <!-- Initialize Alpine data tracking state wrapper -->
    <div class="card shadow border-0" 
         x-data="{ 
            selectedAudience: 'MembersOnly',
            recipientCount: @Model.MembersCount,
            updateCount() {
                // Instantly grabs the data-count attribute from the chosen option node
                const selectEl = document.getElementById('audienceSelect');
                const selectedOpt = selectEl.options[selectEl.selectedIndex];
                this.recipientCount = selectedOpt.getAttribute('data-count');
            }
         }">
         
        <div class="card-header bg-dark text-white p-3">
            <h4 class="mb-0"><i class="bi bi-megaphone-fill me-2"></i>Batch Member Notification</h4>
        </div>
        
        <div class="card-body p-4">
            
            <!-- REAL-TIME REACTIVE BADGE ALERT: Binds styling and count context dynamically -->
            <div class="alert alert-info border-0 bg-opacity-10 bg-info text-dark mb-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill text-info fs-4 me-3"></i>
                    <div>
                        <strong>Target Pool Status:</strong> This action will broadcast a bulk email out to 
                        <!-- Alpine.js x-text replaces text content smoothly without page flickers -->
                        <span class="badge bg-primary fs-6" x-text="recipientCount + ' total targets'"></span> 
                        matching your active system audience filters.
                    </div>
                </div>
            </div>

            <!-- UPDATED FORM ATTR LINE -->
            <form id="broadcastForm" method="post" asp-page-handler="SendBroadcast"
                  x-on:submit.prevent="
                const selectEl = document.getElementById('audienceSelect');
                document.getElementById('modalTargetAudienceText').textContent = selectEl.options[selectEl.selectedIndex].text;
                const confirmModal = new bootstrap.Modal(document.getElementById('sendConfirmModal'));
                confirmModal.show();">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- TARGET SELECTION SYSTEM WITH ALPINE INTEGRATION -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Select Target Audience</label>
                    <select asp-for="NotificationData.TargetAudience" 
                            class="form-select bg-light fw-bold" 
                            id="audienceSelect" 
                            x-model="selectedAudience"
                            x-on:change="updateCount()"
                            required>
                        <option value="MembersOnly" data-count="@Model.MembersCount">Active Members Only</option>
                        <option value="Everyone" data-count="@Model.EveryoneCount">All Members + Newsletter Subscribers</option>
                        <option value="OfficersOnly" data-count="@Model.OfficersCount">Club Officers Only</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Broadcast Subject Line</label>
                    <input asp-for="NotificationData.Subject" class="form-control" placeholder="e.g., Schedule Change" required />
                </div>

                <!-- Text Area Input tracking character length natively via Alpine.js context state variables -->
                <div class="mb-3" x-data="{ textLength: 0 }">
                    <label class="form-label fw-bold">Message Body Content</label>
                    <textarea asp-for="NotificationData.MessageContent" id="broadcastTextArea" class="form-control" rows="8" 
                              x-on:input="textLength = $el.value.length"
                              placeholder="Type your official announcement here..." required></textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <span asp-validation-for="NotificationData.MessageContent" class="text-danger small"></span>
                        <small :class="textLength > 1900 ? 'text-danger fw-bold' : 'text-muted'">
                            <span x-text="textLength">0</span> / 2000 characters
                        </small>
                    </div>
                </div>

                <div class="row g-2 mt-4">
                    <div class="col-md-4">
                        <button type="button" id="previewBtn" class="btn btn-outline-secondary btn-lg w-100">
                            <i class="bi bi-eye-fill me-2"></i>Preview Draft
                        </button>
                    </div>
                    <div class="col-md-8">
                        <button type="submit" class="btn btn-dark btn-lg w-100">
                            <i class="bi bi-send-fill me-2"></i>Dispatch Asynchronous Broadcast
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>    
    <!-- BATCH SEND CONFIRMATION MODAL -->
    <div class="modal fade" id="sendConfirmModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Critical Authorization Verification</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 fw-bold text-danger mb-3">You are about to launch a bulk communication broadcast!</p>
                    <p class="text-muted mb-0">This message will be permanently queued and transmitted directly out to your chosen audience pool filter: </p>
                    <!-- Alpine.js dynamic text inject slot -->
                    <p class="mt-2 fs-5 fw-extrabold text-primary" id="modalTargetAudienceText"></p>
                    <p class="small text-secondary mt-3">Are you absolutely sure you want to execute background dispatch processing?</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel and Abort</button>
                    <!-- Clicking this triggers our final form confirmation injection function -->
                    <button type="button" id="finalSubmitBtn" class="btn btn-danger px-4">
                        <i class="bi bi-send-check-fill me-2"></i>Confirm Send
                    </button>
                </div>
            </div>
        </div>
    </div>


</div>

<!-- LIVE EMAIL PREVIEW MODAL CONTAINER -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-display me-2"></i>Email Layout Preview (John Doe View)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-secondary bg-opacity-10 p-3">
                <!-- Sandbox iframe prevents email styles from bleeding out into your administration dashboard layout styles -->
                <iframe id="previewIframe" style="width: 100%; height: 450px; border: none; background: white; border-radius: 4px;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close Preview</button>
            </div>
        </div>
    </div>
</div>
<hr class="my-5" />

<div class="card shadow border-0">
    <div class="card-header bg-secondary text-white p-3">
        <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Historical Broadcast Audit Ledger</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Sent Date</th>
                        <th>Officer</th>
                        <th>Subject Line</th>
                        <th class="text-center">Recipients</th>
                        <th class="pe-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PastAnnouncements.Any())
                    {
                        foreach (var log in Model.PastAnnouncements)
                        {
                            <tr>
                                <td class="ps-3 text-muted small">@log.SentAt.ToLocalTime().ToString("g")</td>
                                <td class="fw-bold">
                                    @(log.SentByOfficer != null ? $"{log.SentByOfficer.FullName}" : "System")
                                </td>
                                <td><span class="text-truncate d-inline-block" style="max-width: 300px;">@log.Subject</span></td>
                                <td class="text-center"><span class="badge bg-secondary">@log.RecipientCount members</span></td>
                                <td class="pe-3 text-end">
                                    <!-- Leverages the same iframe preview engine logic established earlier to view past copy texts -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-dark view-log-btn"
                                            data-message="@log.MessageContent">
                                        View Text
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-4 text-muted">No historical announcements have been broadcasted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
                // Keep the clean, tag-safe iframe preview logic
                const previewBtn = document.getElementById('previewBtn');
        const textarea = document.getElementById('broadcastTextArea');
        const previewIframe = document.getElementById('previewIframe');
        let bootstrapModalInstance = null;

        document.addEventListener('DOMContentLoaded', function() {
                    bootstrapModalInstance = new bootstrap.Modal(document.getElementById('previewModal'));

            document.querySelectorAll('.view-log-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const rawMessageContent = this.dataset.message || '';
                            const formattedHtml = rawMessageContent.replace(/(?:\r\n|\r|\n)/g, '<br />');
                    const doc = previewIframe.contentDocument || previewIframe.contentWindow.document;

                    doc.open();
                    doc.close();
                    doc.body.style.fontFamily = 'Arial, sans-serif';
                            doc.body.style.padding = '20px';
                    doc.body.style.lineHeight = '1.5';
                    doc.body.style.color = '#333';
                    doc.body.innerHTML = formattedHtml;

                    bootstrapModalInstance.show();
                        });
                    });
                     const finalSubmitBtn = document.getElementById('finalSubmitBtn');
    const broadcastForm = document.getElementById('broadcastForm');

    if (finalSubmitBtn && broadcastForm) {
        finalSubmitBtn.addEventListener('click', function() {
            // Disable button text elements dynamically to protect against rapid multi-click form submissions
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Queueing Broadcast...';
            
            // Bypass Alpine intercept boundaries and push the form to your ASP.NET Core PageModel handler pipeline
            broadcastForm.submit();
        });
    }
                });

        if (previewBtn) {
                    previewBtn.addEventListener('click', function() {
                const bodyValue = textarea.value;
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

                fetch('?handler=PreviewLayout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement.value
                    },
                    body: JSON.stringify({ messageBody: bodyValue })
                        })
                .then(response => response.text())
                .then(htmlOutput => {
                    const doc = previewIframe.contentDocument || previewIframe.contentWindow.document;
                    doc.open();
                            doc.write(htmlOutput);
                    doc.close();
                    bootstrapModalInstance.show();
                });
            });
                }
    </script>
}

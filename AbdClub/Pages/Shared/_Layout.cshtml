@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject AbdClub.Data.AbdContext LayoutDbContext
@using Microsoft.EntityFrameworkCore

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AbdClub</title>

    

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AbdClub.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

</head>
<body>
    <header>
       <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
     <div class="container">
        <!-- 🌟 THE BRANDING LOGO REFACTOR: Replaces plain text with your sharp webp asset -->
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-uppercase tracking-wider" asp-area="" asp-page="/Index">
            <!-- Inline vector rendering scaling dynamically with navigation line heights -->
            <img src="~/images/club-logo.webp" 
                 alt="Austin Ballroom Dancers Logo" 
                 class="d-inline-block align-top img-fluid shadow-sm rounded-circle border border-light" 
                 style="height: 42px; width: 42px; object-fit: cover;" />
            
            <span class="d-none d-sm-inline-block text-dark font-sans-serif" style="font-size: 0.95rem; letter-spacing: 0.5px;">
                Austin <span class="text-danger">Ballroom</span> Dancers
            </span>
        </a>
         <button class="navbar-toggler"
                 type="button"
                 data-bs-toggle="collapse"
                 data-bs-target=".navbar-collapse"
                 aria-controls="navbarSupportedContent"
                 aria-expanded="false"
                 aria-label="Toggle navigation">
             <span class="navbar-toggler-icon"></span>
         </button>
         @inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
         @if (Env.IsDevelopment())
         {
             <span class="navbar-text text-warning ms-auto">Development Mode!</span>
         }
         <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
             <ul class="navbar-nav flex-grow-1">
                 <li class="nav-item">
                     <a class="nav-link text-dark" asp-page="/Index">Home</a>
                 </li>
                 <li class="nav-item">
                     <a class="nav-link text-dark" asp-page="/Dances/Index">Events</a>
                 </li>
                 <li class="nav-item">
                     <a class="nav-link text-dark" asp-page="/Announcements">Announcements</a>
                 </li>
                 @if (await LayoutDbContext.SpecialAnnouncements
                     .AsNoTracking()
                     .AnyAsync(a => a.Id == AbdClub.Models.SpecialAnnouncement.CurrentAnnouncementId && a.IsPublished))
                 {
                     <li class="nav-item">
                         <a class="nav-link text-danger fw-semibold" asp-page="/SpecialAnnouncement">Special Announcement</a>
                     </li>
                 }
                 <li class="nav-item">
                     <a class="nav-link text-dark" asp-page="/MembershipStatus">Membership Status</a>
                 </li>

                 @* 1. REFACTORED TO POLICY: Officers dropdown — visible to anyone matching the "isOfficer" rule *@
                 @if ((await AuthorizationService.AuthorizeAsync(User,null, "isOfficer")).Succeeded)
               {
                     <li class="nav-item dropdown">
                         <a class="nav-link dropdown-toggle text-dark" href="#"
                            id="officersDropdown" role="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                             Officers
                         </a>
                         <ul class="dropdown-menu" aria-labelledby="officersDropdown">
                             <li><a class="dropdown-item" asp-page="/Officers/Dashboard">Officers Dashboard</a></li>
                             <li><a class="dropdown-item" asp-page="/Officers/Members/MembersList">Members</a></li>
                             @* <li><a class="dropdown-item" asp-page="/Officers/Meetings/Index">Meetings</a></li> *@
                             <li><a class="dropdown-item" asp-page="/Officers/Registry/Index">Registry</a></li>
                             <li><a class="dropdown-item" asp-page="/Officers/Dances/Index">Events</a></li>
                             <li><a class="dropdown-item" asp-page="/Officers/Announcements/Edit">Announcement Flyer</a></li>
                             <li><a class="dropdown-item" asp-page="/Officers/SpecialAnnouncement/Edit">Special Announcement</a></li>
                             @* <li><a class="dropdown-item" asp-page="/Officers/Dances/PrintManifests">Print Manifests</a></li> *@
                             <li><a class="dropdown-item" asp-page="/Officers/Locations/Index">Locations</a></li>
                             <li><a class="dropdown-item" asp-page="/Officers/FileManager">Club Files</a></li>
                             <li><a class="dropdown-item" asp-page="/Officers/NewsLetter/Index">Manage NewsLetter Subscribers</a></li>
                         </ul>
                     </li>
                 }

                 @* 2. REFACTORED TO POLICY: Admin dropdown — visible strictly to accounts matching the "isAdmin" rule *@
                 @if ((await AuthorizationService.AuthorizeAsync(User,null, "isAdmin")).Succeeded)
                 {
                     <li class="nav-item dropdown">
                         <a class="nav-link dropdown-toggle text-dark" href="#"
                            id="adminDropdown" role="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                             Admin
                         </a>
                         <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                            <li><a class="dropdown-item" asp-page="/Admin/Index">Admin Dashboard</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/BatchNotify">Admin Broadcast Center</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/EmailLogs/Index">Email Logs</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/ManageHomepage">Manage Home Page</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/OfficerAccounts/Index">Officer Accounts</a></li>
                                 
@*                              <li><a class="dropdown-item" asp-page="/Admin/Dashboard">Executive Panel</a></li>
                             <li><a class="dropdown-item" asp-page="/Admin/Financials">Club Revenue Matrix</a></li>
                             <li><a class="dropdown-item" asp-page="/Admin/EmailLogs">Email Logs</a></li>
                             *@
                         </ul>
                     </li>
                 }
                 
                @* 3. REFACTORED TO POLICY: Dev Link — restricted strictly to accounts matching the "isTechAdmin" rule *@
                 @if ((await AuthorizationService.AuthorizeAsync(User,null, "isTechAdmin")).Succeeded)
                 {
               <li class="nav-item  text-dark   dropdown">
                         <a class="nav-link dropdown-toggle fw-bold text-danger" href="#"
                            id="adminDropdown" role="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                             Dev Zone
                         </a>
                         <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                             <li><a class="dropdown-item" asp-page="/Dev/Index">Dev Dashboard</a></li>
                              <li><a class="dropdown-item" asp-page="/Dev/AuditLogs">Audit Logs</a></li>
                              <li><a class="dropdown-item" asp-page="/Dev/Seed">Seed Test Data</a></li>
                              <li><a class="dropdown-item" asp-page="/Dev/Email">Send Test Email</a></li>
                              <li><a class="dropdown-item" asp-page="/Dev/SheetViewer">Google Membership List</a></li>
                                 
                         </ul>
                     </li>
                     }
                 
                 @* Login — only when NOT logged in  *@
                 @if (User.Identity?.IsAuthenticated != true)
                 {
                     <li class="nav-item">
                         <a class="nav-link text-dark" asp-page="/Auth/Login">Officer Login</a>
                     </li>
                 }

                 @* Join — only when NOT logged in  *@
                 @if (User.Identity?.IsAuthenticated != true)
                 {
                     <li class="nav-item">
                         <a class="nav-link text-dark" asp-page="/Membership">Join</a>
                     </li>
                 }
             </ul>

             @{
                 var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                                      ?? User.Identity?.Name
                                      ?? "Member";
                 var bg = "";
             }
             
             @if (User.Identity?.IsAuthenticated == true)
             {
                 @* Clean status badging container on the right side *@
                 <div class="d-flex align-items-center me-3">
                     @if (User.IsInRole("TechAdmin"))
                     {
                         <span class="badge bg-danger me-2">TechAdmin</span>
                     }
                     else if (User.IsInRole("Admin"))
                     {
                         <span class="badge bg-warning text-dark me-2">Admin</span>
                     }
                     else if (User.IsInRole("Officer"))
                     {
                         <span class="badge bg-primary me-2">Officer</span>
                     }
                 </div>

                 @if (User.IsInRole("Officer"))
                 {
                     bg = "text-primary";
                     var officerTitle = User.FindFirst("OfficerRole")?.Value;
                     <span class="navbar-text ms-auto @bg">
                         Hello, @(!string.IsNullOrEmpty(officerTitle) ? officerTitle + " " : "")@displayName!
                     </span>
                 }
                 else
                 {
                     <span class="navbar-text ms-auto @bg">Hello, @displayName!</span>
                 }
                 
                 <!-- Logout button -->
                 <form method="post" asp-page="/Auth/Logout" class="ms-2 d-inline">
                     <button type="submit" class="btn btn-outline-secondary btn-sm">
                         Sign out
                     </button>
                 </form>
             }
         </div>
     </div>
 </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Austin Ballroom Dancers - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Include Alpine.js directly in the head layout context -->
    <script defer src="~/js/vendor/alpine.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page
@model AbdClub.Pages.Admin.ManageHomepageModel
@{
    ViewData["Title"] = "Homepage CMS Studio";
}

<div class="container mt-4" style="max-width: 1000px;">
    <div class="d-flex align-items-center mb-4">
        <h2><i class="bi bi-palette-fill text-danger me-2"></i>Homepage CMS Studio</h2>
    </div>

    <!-- MODULE A: EDIT MARKETING COPY COPIES -->
    <div class="card shadow-sm border-0 mb-4 overflow-hidden rounded">
        <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-type me-1"></i>Edit Announcement Texts</div>
        <div class="card-body p-4">
            <form method="post" asp-page-handler="SaveText">
                <input type="hidden" asp-for="ContentInput.Id" />
                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted">Primary Marketing Header</label>
                    <input asp-for="ContentInput.MarketingHeader" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted">Secondary Lead Subtitle</label>
                    <textarea asp-for="ContentInput.MarketingSubtitle" class="form-control" rows="2" required></textarea>
                </div>
                <button type="submit" class="btn btn-dark btn-sm shadow-sm"><i class="bi bi-check-circle me-1"></i>Save Layout Texts</button>
            </form>
        </div>
    </div>

    <!-- MODULE B: MANAGING CAROUSEL SLIDER ASSETS -->
    <div class="card shadow-sm border-0 mb-4 rounded overflow-hidden">
        <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-images me-1"></i>Active Carousel Gallery Slides</div>
        <div class="card-body p-4">
            
            <!-- Upload Form -->
            <form method="post" asp-page-handler="AddSlide" enctype="multipart/form-data" class="bg-light p-3 rounded border border-light-subtle mb-4">
                <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-plus-circle me-1"></i>Add Fresh Slide Asset</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">Slide Heading Title</label>
                        <input asp-for="NewSlide.Title" class="form-for form-control form-control-sm" placeholder="e.g., Summer Gala Ballroom" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">Slide Description Caption</label>
                        <input asp-for="NewSlide.Subtitle" class="form-control form-control-sm" placeholder="e.g., Weekly open socials schedule..." required />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-bold small text-muted">Upload Image File</label>
                        <input type="file" name="SlideUploadFile" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">Order Index</label>
                        <input asp-for="NewSlide.DisplayOrder" type="number" class="form-control form-control-sm" />
                    </div>
                </div>
                <button type="submit" class="btn btn-sm btn-dark mt-3 shadow-sm"><i class="bi bi-cloud-arrow-up-fill me-1"></i>Upload Slide to Matrix</button>
            </form>

            <!-- Slides List Grid Table View -->
            <div class="table-responsive border rounded">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th class="ps-3">Preview</th>
                            <th>Heading Content Text Title</th>
                            <th>Order</th>
                            <th class="pe-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var slide in Model.ExistingSlides)
                        {
                            <tr>
                                <td class="ps-3">
                                    <img src="@slide.PhotoUrl" class="rounded border shadow-sm" style="width: 70px; height: 40px; object-fit: cover;" alt="Thumbnail" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@slide.Title</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@slide.Subtitle</div>
                                </td>
                                <td class="font-monospace fw-bold">@slide.DisplayOrder</td>
                                <td class="pe-3 text-end">
                                    <form method="post" asp-page-handler="DeleteSlide" asp-route-id="@slide.Id" onsubmit="return confirm('Permanently remove this homepage slide entry?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1"><i class="bi bi-trash3-fill"></i> Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@page "{id:int}"
@model AbdClub.Pages.Officers.Dances.AttendingOfficersModel
@{
    ViewData["Title"] = "Event Attendance Management";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Officers/FileManager">Officer Panel</a></li>
            <li class="breadcrumb-item"><a asp-page="/Officers/Dances/Index">Dance Matrix</a></li>
            <li class="breadcrumb-item active">Attending Officers</li>
        </ol>
    </nav>

   @*  <div class="mb-4">
        <h2><i class="bi bi-shield-check text-success me-2"></i>Officer Duty Attendance</h2>
        <h5 class="text-muted">Event: <span class="text-dark fw-bold">@Model.TargetDance.Title</span> (@Model.TargetDance.Date.ToString("MMMM dd, yyyy"))</h5>
        <a asp-page-handler="ExportPdf" asp-route-id="@Model.TargetDance.Id" class="btn btn-outline-dark shadow-sm">
            <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>Download Print-Ready PDF
        </a>
    </div> *@

    @if (Model.StatusNotice != null)
    {
        <div class="alert @(Model.StatusNotice.StartsWith("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm mb-4">
            <i class="bi @(Model.StatusNotice.StartsWith("Error") ? "bi-x-circle-fill" : "bi-check-circle-fill") me-2"></i>
            @Model.StatusNotice
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- SELF SERVICE QUICK ACTION HUB -->
    <div class="card bg-light border-0 shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="mb-1">Your Attendance Status</h5>
                <p class="text-muted mb-0">Toggle your status below to indicate if you are working or attending this dance event.</p>
            </div>
            <form method="post" asp-page-handler="ToggleSelfAttendance" asp-route-id="@Model.TargetDance.Id">
                @if (Model.AmIAttending)
                {
                    <button type="submit" class="btn btn-danger btn-lg px-4 shadow-sm">
                        <i class="bi bi-person-dash-fill me-2"></i>Check Me Out of Event
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm">
                        <i class="bi bi-person-check-fill me-2"></i>Check Me into Event
                    </button>
                }
            </form>
        </div>
    </div>

    <div class="row g-4">
        <!-- ROSTER LEDGER SUMMARY -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 small fw-bold text-uppercase"><i class="bi bi-list-stars me-2"></i>Scheduled Officer Roster</h5>
                    <span class="badge bg-primary">@Model.TargetDance.AttendingOfficers.Count Active</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Officer Name</th>
                                <th>Role</th>
                                    <th class="pe-3 text-end" style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TargetDance.AttendingOfficers.Any())
                            {
                                foreach (var officer in Model.TargetDance.AttendingOfficers.OrderBy(o => o.LastName))
                                {
                                    <tr class="@(officer.Id == Model.CurrentMemberId ? "table-success-subtle fw-semibold" : "")">
                                        <td class="ps-3">
                                            @($"{officer.LastName}")
                                            @if (officer.Id == Model.CurrentMemberId)
                                            {
                                                <span class="badge bg-success ms-1 small">You</span>
                                            }
                                        </td>
                                        <td>
                                            <!-- Accesses whatever property field handles assignment role values -->
                                            <span class="badge bg-secondary">@(string.IsNullOrEmpty(officer.OfficerRole) ? "Staff Officer" : officer.OfficerRole)</span>
                                        </td>
                                            <td class="pe-3 text-end">
                                                <form method="post" asp-page-handler="RemoveOfficerOverride"
                                                      asp-route-id="@Model.TargetDance.Id"
                                                      asp-route-dropOfficerId="@officer.Id"
                                                      onsubmit="return confirm('Remove this officer from the schedule roster?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger p-1 line-height-1">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center p-5 text-muted">
                                        <i class="bi bi-shield-slash fs-2 d-block mb-2 text-secondary"></i>
                                        No officers have checked into this assignment roster yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CONDITIONAL ADMINISTRATIVE WORKSPACE (TECH SERGEANT CHEN ONLY) -->
        <div class="col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-danger text-white p-3">
                        <h5 class="mb-0 small fw-bold text-uppercase"><i class="bi bi-shield-lock-fill me-2"></i>Executive Administrative Actions</h5>
                    </div>
                    <form method="post" asp-page-handler="AddOfficerOverride" asp-route-id="@Model.TargetDance.Id" class="card-body p-4">
                        <p class="text-muted small">Use this panel to manually assign other officers to this event if they emailed or requested coordination details directly.</p>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Select Active Officer</label>
                            <select name="selectOfficerId" class="form-select bg-light fw-bold" required>
                                <option value="">-- Choose From Active Officers --</option>
                                @foreach (var available in Model.ActiveOfficersList)
                                {
                                    <option value="@available.Id">@($"{available.LastName} ({available.OfficerRole ?? "No Role Specified"})")</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 mt-2">
                            <i class="bi bi-person-plus-fill me-1"></i>Force Roster Assignment
                        </button>
                    </form>
                </div>
        </div>
    </div>
</div>


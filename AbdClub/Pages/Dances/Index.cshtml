@page
@model AbdClub.Pages.Members.Dances.IndexModel
@{
    ViewData["Title"] = "ABD Events";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="mb-4">
        <h2>Upcoming ABD Events</h2>
        <p class="text-muted">Regular dances, special events, and ABD outings.</p>
    </div>

    @if (Model.VolunteerNotice != null)
    {
        <div class="alert alert-info shadow-sm mb-4">
            <i class="bi bi-info-circle-fill me-2"></i>@Model.VolunteerNotice
        </div>
    }

    @if (Model.ActiveSchedule.Any())
    {
        foreach (var dance in Model.ActiveSchedule)
        {
            <div class="card shadow-sm mb-4 border-0 overflow-hidden">
                <!-- TOP HEADER MATRIX RIBBON -->
                <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1 text-warning">@dance.Title</h4>
                        <span class="badge bg-info text-dark mb-1">@dance.EventTypeLabel</span>
                        <div class="small opacity-75">
                             <button type="button" 
                                            class="btn btn-link text-info p-0 fw-semibold text-decoration-none text-start venue-modal-trigger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#venueDetailModal"
                                            data-name="@dance.Location.VenueName"
                                            data-address="@dance.Location.Address"
                                            data-desc="@(dance.Location.Description ?? "No specialized entrance codes or arrival rules cataloged.")"
                                            data-map="@(dance.Location.GoogleMapsUrl ?? "")"
                                            data-photo="@(dance.Location.PhotoUrl ?? "")">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@dance.Location.VenueName
                                    </button>
                            <i class="bi bi-clock-fill me-1"></i>@dance.StartTime.ToString("h:mm tt") - @dance.EndTime.ToString("h:mm tt")
                        </div>
                    </div>
                    <div class="text-end bg-white bg-opacity-10 px-3 py-2 rounded">
                        <div class="fw-bold">@dance.Date.ToString("MMMM dd")</div>
                        <div class="small opacity-75">@dance.Date.ToString("dddd")</div>
                    </div>
                </div>

                <div class="card-body p-4 bg-light bg-opacity-50">
                    <p class="lead fs-6 mb-4">@dance.Description</p>

                    @if (dance is AbdClub.Models.SpecialEvent && dance.TicketTypes.Any(t =>
                        t.IsActive && !t.IsDoorPrice &&
                        (!t.SalesStartAt.HasValue || t.SalesStartAt <= DateTime.UtcNow) &&
                        (!t.SalesEndAt.HasValue || t.SalesEndAt >= DateTime.UtcNow)))
                    {
                        <a asp-page="/EventTickets" asp-route-eventId="@dance.Id" class="btn btn-danger mb-4">
                            <i class="bi bi-ticket-perforated me-1"></i> Buy Tickets
                        </a>
                    }

                    <div class="row g-4">
                        <!-- COLUMN A: LESSON SCHEDULE DETAILS & DJ -->
                        <div class="col-md-6">
                            @if (dance is AbdClub.Models.Dance regularDance)
                            {
                            <h6 class="fw-bold text-uppercase tracking-wider text-muted mb-3">
                                <i class="bi bi-book-half me-2"></i>Pre-Dance Lesson Details
                            </h6>
                            @if (regularDance.AssignedLesson != null)
    {
        <div class="list-group shadow-sm mb-3">
            <div class="list-group-item bg-white p-3 border border-light-subtle rounded">
                <div class="d-flex w-100 justify-content-between align-items-center">
                    <!-- Assuming your Lesson class uses .Type or .Topic for the description name -->
                    <h5 class="mb-1 text-primary fw-bold">@regularDance.AssignedLesson.Type</h5>
                    <small class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-20 px-2.5 py-1">
                        @regularDance.AssignedLesson.StartTime.ToString("h:mm tt") - @regularDance.AssignedLesson.EndTime.ToString("h:mm tt")
                    </small>
                </div>
                
                <hr class="my-2 border-light-subtle" />

                <!-- Dynamically pulls your master lookup instructor relations metadata info -->
                <small class="text-secondary d-block">
                    <i class="bi bi-person-fill text-muted me-1"></i><strong>Instructor:</strong> 
                    @(regularDance.AssignedLesson.Instructor != null ? regularDance.AssignedLesson.Instructor.Name : "TBD / Unassigned")
                </small>
            </div>
        </div>
    }
    else
    {
        <!-- Fallback baseline alert if no pre-dance instruction session is bound to the record -->
        <div class="text-center py-4 bg-light border border-light-subtle rounded mb-3">
            <i class="bi bi-calendar-x text-muted display-6 opacity-50 d-block mb-1"></i>
            <span class="text-muted small fw-medium">No instructional lesson block configured for this date.</span>
        </div>
    }
                            }

                            <!-- EXPOSED MASTER DJ TIER REGISTRY SLOT -->
                            @if (dance is not AbdClub.Models.Outing)
                            {
                            <div class="card border-0 shadow-sm bg-white p-3">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 bg-dark text-white rounded p-2 px-3 me-3">
                                        <i class="bi bi-disc-fill fs-5 text-warning"></i>
                                    </div>
                                    <div>
                                        <small class="text-uppercase tracking-wider text-muted fw-bold d-block" style="font-size: 0.7rem;">Entertainment</small>
                                        <span class="fw-bold text-dark">@(dance.AssignedDj != null ? $"{dance.AssignedDj.Name} ({dance.AssignedDj.EntertainmentType})" : "To be announced")</span>
                                    </div>
                                </div>
                            </div>
                            }

                            @if (dance is AbdClub.Models.Outing outing)
                            {
                                @if (!string.IsNullOrWhiteSpace(outing.RegistrationInstructions))
                                {
                                    <div class="alert alert-info mt-3 mb-0">@outing.RegistrationInstructions</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(outing.ExternalWebsiteUrl))
                                {
                                    <a href="@outing.ExternalWebsiteUrl" target="_blank" rel="noopener" class="btn btn-outline-primary mt-3">Visit event website</a>
                                }
                            }
                        </div>

                        <!-- COLUMN B: DYNAMIC VOLUNTEER SHIFT INTERFACE (HIDDEN FOR NON-MEMBERS) -->
                        <div class="col-md-6">
                            @if (User.Identity != null && User.Identity.IsAuthenticated && User.HasClaim(c => c.Type == "MemberId"))
                            {
                                <h6 class="fw-bold text-uppercase tracking-wider text-muted mb-3">
                                    <i class="bi bi-people-fill me-2"></i>Volunteer Coordination
                                </h6>
                                <div class="bg-white p-3 rounded border shadow-sm">

                                    @{
                                        // Define standard staffing job configuration values to track against
                                        var coreDuties = new[] { "Front Desk Check-in", "Setup Team", "Clean Up Crew" };

                                        // Extract browsing member email out of context claim tokens once for speed performance
                                        var contextUserEmail = User.FindFirst("Email")?.Value?.Trim().ToLowerInvariant() ?? string.Empty;
                                    }

                                    <div class="vstack gap-3">
                                        @foreach (var duty in coreDuties)
                                        {
                                            // Inspect your collection array looking at the Notes text field where we save the active duty role assignment
                                            var filledSlot = dance.AssignedVolunteers
                                                .FirstOrDefault(v => v.Notes != null && v.Notes.Contains(duty));

                                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                                <div>
                                                    <span class="d-block fw-semibold text-dark">@duty</span>
                                                    @if (filledSlot != null)
                                                    {
                                                        <small class="text-success fw-medium">
                                                            <i class="bi bi-check-circle-fill me-1"></i>Filled: @filledSlot.Name
                                                        </small>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-danger"><i class="bi bi-dash-circle me-1"></i>Slot Open</small>
                                                    }
                                                </div>

                                                @if (filledSlot == null)
                                                {
                                                    <!-- Safe HTTP POST form pipeline routing down the updated registration handler -->
                                                    <form method="post" asp-page-handler="Volunteer">
                                                        <input type="hidden" name="danceId" value="@dance.Id" />
                                                        <input type="hidden" name="dutyType" value="@duty" />
                                                        <button type="submit" class="btn btn-sm btn-outline-primary px-3">Claim Shift</button>
                                                    </form>
                                                }
                                                else if (filledSlot.Email?.Trim().ToLowerInvariant() == contextUserEmail)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success p-2">Your Assignment</span>
                                                }
                                                else
                                                {
                                                    <!-- Renders a generic locked tag element if another registry contact holds the assignment slot position -->
                                                    <span class="badge bg-light text-muted border p-2">Assigned</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                </div>
                            }
                        </div>

                        

                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center p-5 bg-light rounded shadow-sm">
            <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
            <h4>No Active Schedules Registered</h4>
            <p class="text-muted">Check back later for newly scheduled social dancing events.</p>
        </div>
    }
      <!-- Render the reusable venue popup partial view shell at the bottom of the root wrapper -->
    <partial name="_VenueDetailModal" />
</div>

@page
@model AbdClub.Pages.Members.Dances.IndexModel
@{
    ViewData["Title"] = "Dance Calendars & Opportunities";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="mb-4">
        <h2>Upcoming Dance Calendar</h2>
        <p class="text-muted">Check out scheduled sessions, preview lesson topics, or claim an event helper shift position.</p>
    </div>

    @if (Model.VolunteerNotice != null)
    {
        <div class="alert alert-info shadow-sm mb-4">
            <i class="bi bi-info-circle-fill me-2"></i>@Model.VolunteerNotice
        </div>
    }

    @if (Model.ActiveSchedule.Any())
    {
        foreach (var dance in Model.ActiveSchedule)
        {
            <div class="card shadow-sm mb-4 border-0 overflow-hidden">
                <!-- TOP HEADER MATRIX RIBBON -->
                <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1 text-warning">@dance.Title</h4>
                        <div class="small opacity-75">
                            <i class="bi bi-geo-alt-fill me-1"></i>@dance.Location &nbsp;|&nbsp;
                            <i class="bi bi-clock-fill me-1"></i>@dance.StartTime.ToString("h:mm tt") - @dance.EndTime.ToString("h:mm tt")
                        </div>
                    </div>
                    <div class="text-end bg-white bg-opacity-10 px-3 py-2 rounded">
                        <div class="fw-bold">@dance.Date.ToString("MMMM dd")</div>
                        <div class="small opacity-75">@dance.Date.ToString("dddd")</div>
                    </div>
                </div>

                <div class="card-body p-4 bg-light bg-opacity-50">
                    <p class="lead fs-6 mb-4">@dance.Description</p>

                    <div class="row g-4">
                        <!-- COLUMN A: LESSON SCHEDULE DETAILS -->
                        <div class="col-md-6">
                            <h6 class="fw-bold text-uppercase tracking-wider text-muted mb-3"><i class="bi bi-book-half me-2"></i>Pre-Dance Lessons</h6>
                            @if (dance.Lessons.Any())
                            {
                                <div class="list-group shadow-sm">
                                    @foreach (var lesson in dance.Lessons.OrderBy(l => l.StartTime))
                                    {
                                        <div class="list-group-item bg-white">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1 text-primary fw-semibold">@lesson.Type</h6>
                                                <small class="text-muted">@lesson.StartTime.ToString("h:mm tt")</small>
                                            </div>
                                            @* <small class="text-secondary d-block">Level: @lesson.Level</small> *@
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small bg-white p-3 rounded border">No instructional lessons configured for this date.</p>
                            }
                        </div>

                        <!-- COLUMN B: REFACTORED VOLUNTEER SHIFT INTERFACE (MASTER REGISTRY ARCHITECTURE) -->
                        <div class="col-md-6">
                            <h6 class="fw-bold text-uppercase tracking-wider text-muted mb-3">
                                <i class="bi bi-people-fill me-2"></i>Volunteer Coordination
                            </h6>
                            <div class="bg-white p-3 rounded border shadow-sm">

                                @{
                                    // Define standard staffing job configuration values to track against
                                    var coreDuties = new[] { "Front Desk Check-in", "Setup Team", "Clean Up Crew" };

                                    // Extract browsing member email out of context claim tokens once for speed performance
                                    var contextUserEmail = User.FindFirst("Email")?.Value?.Trim().ToLowerInvariant() ?? string.Empty;
                                }

                                <div class="vstack gap-3">
                                    @foreach (var duty in coreDuties)
                                    {
                                        // Inspect your new collection array looking at the Notes text field where we save the active duty role assignment
                                        var filledSlot = dance.AssignedVolunteers
                                            .FirstOrDefault(v => v.Notes != null && v.Notes.Contains(duty));

                                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                            <div>
                                                <span class="d-block fw-semibold text-dark">@duty</span>
                                                @if (filledSlot != null)
                                                {
                                                    <small class="text-success fw-medium">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Filled: @filledSlot.Name
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-danger"><i class="bi bi-dash-circle me-1"></i>Slot Open</small>
                                                }
                                            </div>

                                            @if (filledSlot == null)
                                            {
                                                <!-- Safe HTTP POST form pipeline routing down the updated registration handler -->
                                                <form method="post" asp-page-handler="Volunteer">
                                                    <input type="hidden" name="danceId" value="@dance.Id" />
                                                    <input type="hidden" name="dutyType" value="@duty" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary px-3">Claim Shift</button>
                                                </form>
                                            }
                                            else if (filledSlot.Email?.Trim().ToLowerInvariant() == contextUserEmail)
                                            {

                                                <span class="badge bg-success-subtle text-success border border-success p-2">Your Assignment</span>
                                            }
                                            else
                                            {
                                                <!-- Renders a generic locked tag element if another registry contact holds the assignment slot position -->
                                                <span class="badge bg-light text-muted border p-2">Assigned</span>
                                            }
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>

                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center p-5 bg-light rounded shadow-sm">
            <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
            <h4>No Active Schedules Registered</h4>
            <p class="text-muted">Check back later for newly scheduled social dancing events.</p>
        </div>
    }
</div>


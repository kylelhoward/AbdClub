@page "/Dev/SheetViewer"
@model AbdClub.Pages.Dev.SheetViewerModel
@{
    ViewData["Title"] = "Developer Sandbox — Google Sheet Inspector";
}

<div class="container-fluid py-4" style="max-width: 1400px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-page="/Admin/Dashboard">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-page="/Dev/Index">Developer Hub</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Google Sheet Viewer</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-file-earmark-spreadsheet-fill text-success me-2"></i>Google Sheet Live Inspector
            </h2>
            <p class="text-muted small mb-0">
                Inspect and import rows from the <strong>Membership_raw</strong> tab or push the current roster to Google Sheets.
            </p>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <a href="https://docs.google.com/spreadsheets/d/@Model.TargetSheetId" target="_blank" class="btn btn-sm btn-outline-success">
                <i class="bi bi-box-arrow-up-right me-1"></i>Open Sheet
            </a>
            <a asp-page="./SheetViewer" class="btn btn-sm btn-dark">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </a>

            <form method="post" asp-page-handler="TriggerExport" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-primary fw-bold">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i>Push Roster
                </button>
            </form>

            <form method="post" asp-page-handler="ImportMemberships" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary fw-bold">
                    <i class="bi bi-download me-1"></i>Import Membership_raw
                </button>
            </form>
        </div>

    </div>

    @if (TempData["ImportResult"] is string importMsg && !string.IsNullOrWhiteSpace(importMsg))
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3 p-3 mb-4">
            <div class="d-flex align-items-start">
                <i class="bi bi-info-circle-fill fs-4 text-info me-3"></i>
                <div>
                    <div class="small">@importMsg</div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 p-4 mb-4">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-octagon-fill fs-3 text-danger me-3"></i>
                <div>
                    <h5 class="fw-bold mb-1">Google Sheets Sync Error</h5>
                    <p class="mb-2 small">@Model.ErrorMessage</p>
                    <div class="small text-muted">
                        <strong>Troubleshooting Checklist:</strong>
                        <ul class="mb-0 mt-1">
                            <li>Confirm that <code>abdclub-81c5d585c9db.json</code> is placed inside <code>Data/Publishing/</code>.</li>
                            <li>Ensure the Google Sheet has been shared with your Service Account email (<code>client_email</code> inside the json).</li>
                            <li>Check that the Google Sheets API is enabled in your Google Cloud Console.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Summary Metric Badges -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-light">
                    <span class="text-muted small fw-bold text-uppercase">Total Rows Loaded</span>
                    <span class="fs-4 fw-bold text-dark font-monospace">@Model.TotalRowsCount</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-light">
                    <span class="text-muted small fw-bold text-uppercase">Active Members</span>
                    <span class="fs-4 fw-bold text-success font-monospace">
                        @Model.Rows.Count(r => !r.IsExpired)
                    </span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-light">
                    <span 
                        class="text-muted small fw-bold text-uppercase">Lapsed / Expired</span>
                    <span 
                        class="fs-4 fw-bold text-warning font-monospace">
                        @Model.Rows.Count(r => r.IsExpired)
                    </span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-light">
                    <span
                        class="text-muted small fw-bold text-uppercase">Email Bounce Warnings</span>
                    <span 
                        class="fs-4 fw-bold text-danger font-monospace">
                        @Model.Rows.Count(r => r.IsEmailBounced)
                    </span>
                </div>
            </div>
        </div>

        <!-- Data Grid -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap small">
                    <thead class="table-dark font-monospace text-uppercase" style="font-size: 0.75rem;">
                        <tr>
                            <th class="ps-3" style="width: 60px;">Row</th>
                            <th>First Name (B)</th>
                            <th>Last Name (C)</th>
                            <th>Full Name (D)</th>
                            <th>Expiration Date (E)</th>
                            <th>Phone (F)</th>
                            <th class="pe-3">Email (G)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Rows.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    No records found in the specified range.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace text-muted">@row.RowIndex</td>
                                    <td class="fw-semibold">@row.FirstName</td>
                                    <td class="fw-semibold">@row.LastName</td>
                                    <td class="text-secondary font-monospace">@row.FullName</td>
                                    <td>
                                        @if (row.ParsedExpirationDate.HasValue)
                                        {
                                            @if (row.IsExpired)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                                    <i class="bi bi-clock-history me-1"></i>@row.ParsedExpirationDate.Value.ToString("yyyy-MM-dd") (Expired)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                    <i class="bi bi-check-circle me-1"></i>@row.ParsedExpirationDate.Value.ToString("yyyy-MM-dd")
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted font-monospace">@row.RawExpirationDate</span>
                                        }
                                    </td>
                                    <td class="font-monospace">
                                        @if (!string.IsNullOrEmpty(row.Phone))
                                        {
                                            <a href="tel:@row.Phone" class="text-decoration-none text-dark">@row.Phone</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="pe-3">
                                        @if (row.IsEmailBounced)
                                        {
                                            <!-- Red highlighted bounce-back styling -->
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 font-monospace" title="Email marked as bounced">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@row.Email (Bounced)
                                            </span>
                                        }
                                        else if (!string.IsNullOrEmpty(row.Email))
                                        {
                                            <a href="mailto:@row.Email" class="text-decoration-none font-monospace text-primary">
                                                @row.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


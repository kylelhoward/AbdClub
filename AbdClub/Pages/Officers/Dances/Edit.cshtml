@page "{id:int}"
@model AbdClub.Pages.Officers.Dances.EditModel
@{
    ViewData["Title"] = "Comprehensive Event Matrix Editor";
}

<div class="container mt-4" style="max-width: 1100px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Officers/FileManager">Officer Panel</a></li>
            <li class="breadcrumb-item"><a asp-page="/Officers/Dances/Index">Dance Matrix</a></li>
            <li class="breadcrumb-item active">Master Edit</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2><i class="bi bi-gear-wide-connected text-dark me-2"></i>Master Event Configuration</h2>
        <h5 class="text-muted">Targeting: <span class="text-primary fw-bold">@Model.TargetDance.Title</span> (@Model.TargetDance.Date.ToString("yyyy-MM-dd"))</h5>
    </div>

    @if (Model.UpdateFeedback != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.UpdateFeedback
            <button type="button" class="btn-close" data-bs-alert data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Setup structural JSON serialization configurations so Alpine can read existing records natively -->
    <form method="post" id="masterForm" class="row g-4"
          x-data='{
        lessons: @Html.Raw(Json.Serialize(Model.FormInput.Lessons ?? new List<LessonInputItem>())),
        addLesson() {
        this.lessons.push({ instructorid: 0, type: "", starttime: "19:00", endtime: "20:00" });
        },
        removeLesson(index) {
        this.lessons.splice(index, 1);
        }
        }'
          action="/Officers/Dances/Edit/2?handler=UpdateRoster">
              <div asp-validation-summary="ModelOnly" class="text-danger small col-12"></div>

        <!-- LEFT COLUMN: DJ AND LOOKUP REGISTRY SELECTIONS -->
        <div class="col-lg-5">
            <!-- TIER A: MASTER DJ LOOKUP REGISTRY SELECTION -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="mb-0 text-uppercase tracking-wider fw-bold small"><i class="bi bi-disc-fill me-2"></i>Assigned Event DJ</h6>
                </div>
                <div class="card-body p-3">
                    <label class="form-label small fw-bold text-muted mb-1">Select Lookup Registry DJ</label>
                    <select asp-for="FormInput.SelectedDjId" class="form-select bg-light fw-semibold">
                        <option value="">-- No DJ Assigned / Vacant Position --</option>
                        @foreach (var dj in Model.RegistryDjs)
                        {
                            <option value="@dj.Id">@dj.Name</option>
                        }
                    </select>
                </div>
            </div>

            <!-- TIER B: MULTI-SELECT ROSTER GRID SYSTEM (LOOKUPS) -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="mb-0 text-uppercase tracking-wider fw-bold small"><i class="bi bi-person-lines-fill me-2"></i>Staff & Helper Registries</h6>
                </div>
                <div class="card-body p-3 vstack gap-3">
                    <!-- Hosts Selection -->
                    <div>
                        <label class="fw-bold small mb-1 text-muted d-block"><i class="bi bi-person-badge-fill me-1 text-primary"></i>Dance Hosts</label>
                        <div class="border bg-white rounded p-2" style="max-height: 110px; overflow-y: auto;">
                            @foreach (var host in Model.RegistryHosts)
                            {
                                bool isChecked = Model.CurrentlyAssignedHostIds.Contains(host.Id);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="FormInput.SelectedHostIds" value="@host.Id" id="h_@host.Id" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label small" for="h_@host.Id">@host.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Instructors Selection -->
                    <div>
                        <label class="fw-bold small mb-1 text-muted d-block"><i class="bi bi-mortarboard-fill me-1 text-success"></i>Instructors</label>
                        <div class="border bg-white rounded p-2" style="max-height: 110px; overflow-y: auto;">
                            @foreach (var instructor in Model.RegistryInstructors)
                            {
                                bool isChecked = Model.CurrentlyAssignedInstructorIds.Contains(instructor.Id);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="FormInput.SelectedInstructorIds" value="@instructor.Id" id="i_@instructor.Id" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label small" for="i_@instructor.Id">@instructor.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Volunteers Selection -->
                    <div>
                        <label class="fw-bold small mb-1 text-muted d-block"><i class="bi bi-heart-fill me-1 text-danger"></i>Volunteers</label>
                        <div class="border bg-white rounded p-2" style="max-height: 110px; overflow-y: auto;">
                            @foreach (var vol in Model.RegistryVolunteers)
                            {
                                bool isChecked = Model.CurrentlyAssignedVolunteerIds.Contains(vol.Id);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="FormInput.SelectedVolunteerIds" value="@vol.Id" id="v_@vol.Id" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label small" for="v_@vol.Id">@vol.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- TIER C: SHIFT CHECKLIST FOR ATTENDING OFFICERS -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="mb-0 text-uppercase tracking-wider fw-bold small"><i class="bi bi-shield-lock-fill me-2"></i>Attending Duty Officers</h6>
                </div>
                <div class="card-body p-3">
                    <div class="border rounded bg-white p-2" style="max-height: 180px; overflow-y: auto;">
                        @foreach (var officer in Model.AllActiveOfficers)
                        {
                            bool isChecked = Model.CurrentlyAssignedOfficerIds.Contains(officer.Id);
                            <div class="form-check p-1 border-bottom border-light">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="FormInput.SelectedOfficerIds" value="@officer.Id" id="of_@officer.Id" @(isChecked ? "checked" : "") />
                                <label class="form-check-label small fw-bold text-dark pt-0" for="of_@officer.Id">@($"{officer.FullName}")</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- RIGHT COLUMN: DYNAMIC LESSON MANAGEMENT PANEL AREA -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 h-100 d-flex flex-column">
                <div class="card-header bg-secondary text-white p-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 text-uppercase tracking-wider fw-bold small"><i class="bi bi-journal-bookmark-fill me-2"></i>Event Pre-Dance Lessons</h6>
                    <button type="button" class="btn btn-sm btn-light fw-bold" x-on:click="addLesson()">
                        <i class="bi bi-plus-circle-fill text-success me-1"></i>Add Lesson Slot
                    </button>
                </div>

                <div class="card-body p-3 flex-grow-1">
                    <!-- Template Loop Slot running via Alpine array controls -->
                    <template x-for="(lesson, index) in lessons" :key="index">
                        <div class="bg-light border rounded p-3 mb-3 position-relative shadow-sm">
                            <button type="button" class="btn-close position-absolute top-0 end-0 m-2 btn-sm text-danger" style="font-size:0.75rem;" x-on:click="removeLesson(index)"></button>

                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-muted mb-0">Lesson Topic / Type</label>
                                    <!-- FIXED: x-model tracks .type -->
                                    <input type="text" :name="'FormInput.Lessons['+index+'].Type'" x-model="lesson.type" class="form-control form-control-sm" placeholder="e.g., East Coast Swing (Intro)" required />
                                </div>

                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-muted mb-0">Instructor Name</label>
                                    <!-- FIXED: x-model tracks .instructorId -->
                                    <select :name="'FormInput.Lessons['+index+'].InstructorId'" x-model="lesson.instructorId" class="form-select form-select-sm" required>
                                        <option value="">-- Choose Instructor --</option>
                                        @foreach (var inst in Model.RegistryInstructors)
                                        {
                                            <option value="@inst.Id">@inst.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-muted mb-0">Start Time</label>
                                    <!-- FIXED: x-model tracks .startTime -->
                                    <input type="time" :name="'FormInput.Lessons['+index+'].StartTime'" x-model="lesson.startTime" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-muted mb-0">End Time</label>
                                    <!-- FIXED: x-model tracks .endTime -->
                                    <input type="time" :name="'FormInput.Lessons['+index+'].EndTime'" x-model="lesson.endTime" class="form-control form-control-sm" required />
                                </div>
                            </div>
                        </div>
                    </template>
                    <div x-show="lessons.length === 0" class="text-center text-muted p-5 my-auto">
                        <i class="bi bi-journals fs-3 d-block mb-2 text-opacity-50"></i>
                        No instructional lessons configured for this social dance yet.
                    </div>
                </div>

                <div class="card-footer bg-light p-3 d-flex justify-content-between mt-auto">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" id="masterSubmitBtn" class="btn btn-dark px-4">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i>Commit Master Roster Update
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('masterForm');
            const submitBtn = document.getElementById('masterSubmitBtn');

            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing Email Notifiers & DB Queries...';
                });
            }
        });
    </script>
}

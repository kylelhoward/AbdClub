@page "{id:int}"
@model AbdClub.Pages.Officers.Dances.EditModel
@using System.Text.Encodings.Web
@{
    // 🌟 Establish read-only context conditions globally for this render pipeline
    bool isReadOnly = !User.IsInRole("Admin") && !User.IsInRole("TechAdmin");
    ViewData["Title"] = isReadOnly ? "View Event Details" : "Edit Event Details";
}

<!-- Pull down Alpine tool structures natively hosted locally -->
<script defer src="~/js/vendor/alpine.min.js" asp-append-version="true"></script>

<div class="container mt-4" style="max-width: 1000px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Officers/FileManager">Officer Panel</a></li>
            <li class="breadcrumb-item"><a asp-page="/Officers/Dances/Index">Dance Matrix</a></li>
            <li class="breadcrumb-item active">@(isReadOnly ? "View Event Details" : "Edit Event Details")</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2><i class="bi bi-gear-wide-connected text-dark me-2"></i>Master Event Configuration</h2>
        <h5 class="text-muted">
            Dance Id @Model.TargetDance.Id: 
            <span class="text-primary fw-bold">@Model.TargetDance.Title</span> (@Model.TargetDance.Date.ToString("yyyy-MM-dd"))
        </h5>
    </div>

    @if (Model.UpdateFeedback != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.UpdateFeedback
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 
        Unified Form utilizing precise single quotes for x-data boundaries.
        The system forces exact PascalCase serialization parameters to match lesson casing fields.
    -->
    <form 
        method="post" 
        asp-page-handler="UpdateRoster"
        id="masterForm" 
        class="vstack gap-4"
          >

        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <!-- MASTER STAFFING ACCORDION SYSTEM -->
        <div class="accordion shadow-sm" id="danceMatrixAccordion">
           
        <!-- ACCORDION ITEM 0: CORE EVENT TEXT DETAILS -->

        <div class="accordion-item border-0 mb-2 overflow-hidden rounded shadow-sm">
            <h2 class="accordion-header" id="headingCoreInfo">
                <button class="accordion-button bg-dark text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCoreInfo" aria-expanded="true" aria-controls="collapseCoreInfo">
                    <i class="bi bi-info-circle-fill me-2 text-warning"></i>Core Event Details
                </button>
            </h2>
            <div 
                id="collapseCoreInfo" 
                class="accordion-collapse collapse show" 
                aria-labelledby="headingCoreInfo" 
                data-bs-parent="#danceMatrixAccordion">
                <div class="accordion-body bg-white p-4">
                    <div class="row g-3">
                        
                        <!-- Row 1: Event Title (Left 8 Columns) -->
                        <div class="col-md-8">
                            <label 
                                class="form-label fw-bol/d small text-muted mb-1">Dance Event Title</label>
                            <input 
                                asp-for="FormInput.Title" 
                                class="form-control form-control-lg fw-semibold" 
                                placeholder="e.g., Summer Retro Swing Gala"
                                disabled="@isReadOnly"
                                required />
                            <span asp-validation-for="FormInput.Title" class="text-danger small"></span>
                        </div>

                        <!-- 🌟 NEW LOCATION DROPDOWN (Right 4 Columns) -->
                        <div class="col-md-4">
                            <label 
                                class="form-label fw-bold small text-muted mb-1">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>Assigned Venue / Hall</label>
                            <select 
                                asp-for="FormInput.SelectedLocationId" 
                                class="form-select form-select-lg bg-light fw-medium text-dark" 
                                disabled="@isReadOnly"
                                required>
                                <option value="">-- Select Venue --</option>
                                @foreach (var venue in Model.AvailableVenues)
                                {
                                    <option value="@venue.Id">@venue.VenueName</option>
                                }
                            </select>
                            <span asp-validation-for="FormInput.SelectedLocationId" class="text-danger small"></span>
                        </div>

                        <!-- Row 2: Organizer Contact Email (Added back for completeness) -->
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted mb-1">Organizer Contact Email</label>
                            <input 
                                asp-for="FormInput.ContactEmail"
                                type="email"
                                class="form-control text-secondary"
                                placeholder="e.g., info@abdclub.org"
                                disabled="@isReadOnly"/>
                            <span asp-validation-for="FormInput.ContactEmail" class="text-danger small"></span>
                        </div>

                        <!-- Row 3: Date and Operational Window Matrices -->
                        <div class="col-md-4">
                            <label 
                                class="form-label fw-bold small text-muted mb-1">
                                <i class="bi bi-calendar3 me-1 text-primary"></i>Target Event Date</label>
                            <input 
                                asp-for="FormInput.Date"
                                type="date" 
                                class="form-control"
                                disabled="@isReadOnly"
                                required />
                            <span asp-validation-for="FormInput.Date" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted mb-1"><i class="bi bi-clock me-1 text-success"></i>Doors / Start Time</label>
                            <input 
                                asp-for="FormInput.StartTime"
                                type="time"
                                class="form-control"
                                disabled="@isReadOnly"
                                required />
                            <span asp-validation-for="FormInput.StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted mb-1"><i class="bi bi-clock-fill me-1 text-danger"></i>Curfew / End Time</label>
                            <input 
                                asp-for="FormInput.EndTime"
                                type="time" 
                                class="form-control"
                                disabled="@isReadOnly"
                                required />
                            <span asp-validation-for="FormInput.EndTime" class="text-danger small"></span>
                        </div>

                        <!-- Row 4: Public Calendar Announcement Description -->
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted mb-1">Public Calendar Announcement Description</label>
                            <textarea
                                asp-for="FormInput.Description" 
                                class="form-control" rows="3"
                                placeholder="Provide public details about pricing, themes, attire rules..."
                                disabled="@isReadOnly"></textarea>
                            <span asp-validation-for="FormInput.Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>





            <!-- ACCORDION ACCORDION ITEM 1: MASTER DJ CONFIGURATION -->
            <div class="accordion-item border-0 mb-2 overflow-hidden rounded shadow-sm">
                <h2 class="accordion-header" id="headingDj">
                    <button class="accordion-button bg-dark text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDj" aria-expanded="true" aria-controls="collapseDj">
                        <i class="bi bi-disc-fill me-2 text-warning"></i>Assigned Event DJ Lookup
                    </button>
                </h2>
                <div id="collapseDj" class="accordion-collapse collapse " aria-labelledby="headingDj" data-bs-parent="#danceMatrixAccordion">
                    <div class="accordion-body bg-white p-4">
                        <label class="form-label small fw-bold text-muted mb-1">Select Lookup Registry DJ</label>
                        <select
                            asp-for="FormInput.SelectedDjId"
                            class="form-select form-select-lg bg-light border-light-subtle fw-semibold text-dark"
                            disabled="@isReadOnly">
                            <option value="">-- No DJ Assigned / Vacant Position --</option>
                            @foreach (var dj in Model.RegistryDjs)
                            {
                                <option value="@dj.Id">@dj.Name @(!string.IsNullOrEmpty(dj.Email) ? $"({dj.Email})" : "")</option>
                            }
                        </select>
                        @if (Model.TargetDance.AssignedDj != null && !string.IsNullOrEmpty(Model.TargetDance.AssignedDj.Email))
                        {
                            <div class="mt-2 small">
                                <span class="text-muted">Active Contact:</span> 
                                <a href="mailto:@Model.TargetDance.AssignedDj.Email" class="fw-medium text-decoration-none"><i class="bi bi-envelope-at me-1"></i>@Model.TargetDance.AssignedDj.Email</a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ACCORDION ITEM 2: HOSTS AND VOLUNTEERS DIRECTORIES -->
            <div class="accordion-item border-0 mb-2 overflow-hidden rounded shadow-sm">
                <h2 class="accordion-header" id="headingStaff">
                    <button class="accordion-button collapsed bg-dark text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStaff" aria-expanded="false" aria-controls="collapseStaff">
                        <i class="bi bi-person-lines-fill me-2 text-info"></i>Staff & Helper Registries
                    </button>
                </h2>
                <div id="collapseStaff" class="accordion-collapse collapse" aria-labelledby="headingStaff" data-bs-parent="#danceMatrixAccordion">
                    <div class="accordion-body bg-white p-4">
                        <div class="row g-4">
                            <!-- Dance Hosts Checklist -->
                            <div class="col-md-6">
                                <label class="fw-bold small mb-2 text-muted d-block"><i class="bi bi-person-badge-fill me-1 text-primary"></i>Dance Hosts Directory</label>
                                <div class="border bg-white rounded p-3" style="max-height: 220px; overflow-y: auto;">
                                    @foreach (var host in Model.RegistryHosts)
                                    {
                                        bool isChecked = Model.CurrentlyAssignedHostIds.Contains(host.Id);
                                        <div class="form-check p-2 border-bottom border-light d-flex justify-content-between align-items-center">
                                            <div>
                                                <input
                                                    class="form-check-input ms-0 me-2"
                                                    type="checkbox"
                                                    name="FormInput.SelectedHostIds"
                                                    value="@host.Id"
                                                    id="h_@host.Id" @(isChecked ? "checked" : "")
                                                    disabled="@isReadOnly"/>
                                                <label class="form-check-label small fw-semibold text-dark" for="h_@host.Id">@host.Name</label>
                                            </div>
                                            @if (!string.IsNullOrEmpty(host.Email))
                                            {
                                                <a href="mailto:@host.Email" class="small text-muted text-decoration-none" title="Email Host"><i class="bi bi-envelope me-1"></i>Link</a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Volunteers Checklist -->
                            <div class="col-md-6">
                                <label class="fw-bold small mb-2 text-muted d-block"><i class="bi bi-heart-fill me-1 text-danger"></i>Volunteers Directory</label>
                                <div class="border bg-white rounded p-3" style="max-height: 220px; overflow-y: auto;">
                                    @foreach (var vol in Model.RegistryVolunteers)
                                    {
                                        bool isChecked = Model.CurrentlyAssignedVolunteerIds.Contains(vol.Id);
                                        <div class="form-check p-2 border-bottom border-light d-flex justify-content-between align-items-center">
                                            <div>
                                                <input
                                                    class="form-check-input ms-0 me-2"
                                                    type="checkbox"
                                                    name="FormInput.SelectedVolunteerIds"
                                                    value="@vol.Id" id="v_@vol.Id"
                                                    @(isChecked ? "checked" : "")
                                                    disabled="@isReadOnly"/>
                                                <label class="form-check-label small fw-semibold text-dark" for="v_@vol.Id">@vol.Name</label>
                                            </div>
                                            @if (!string.IsNullOrEmpty(vol.Email))
                                            {
                                                <a href="mailto:@vol.Email" class="small text-muted text-decoration-none" title="Email Volunteer"><i class="bi bi-envelope me-1"></i>Link</a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
        
                    <!-- ACCORDION ITEM 3: ATTENDING DUTY OFFICERS LISTS -->
            <div class="accordion-item border-0 mb-2 overflow-hidden rounded shadow-sm">
                <h2 class="accordion-header" id="headingOfficers">
                    <button class="accordion-button collapsed bg-dark text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOfficers" aria-expanded="false" aria-controls="collapseOfficers">
                        <i class="bi bi-shield-lock-fill me-2 text-secondary"></i>Attending Duty Officers
                    </button>
                </h2>
                <div id="collapseOfficers" class="accordion-collapse collapse" aria-labelledby="headingOfficers" data-bs-parent="#danceMatrixAccordion">
                    <div class="accordion-body bg-white p-4">
                        <p class="text-muted small mb-3">Check or uncheck the boxes below to manage officer assignments for this dance event. Toggling statuses automatically coordinates layout updates and triggers automated email notices.</p>
                        <div class="border rounded bg-white p-3" style="max-height: 240px; overflow-y: auto;">
                            <div class="row row-cols-1 row-cols-md-2 g-2">
                                @foreach (var officer in Model.AllActiveOfficers)
                                {
                                    bool isChecked = Model.CurrentlyAssignedOfficerIds.Contains(officer.Id);
                                    <div class="col">
                                        <div class="form-check p-2 border rounded bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center">
                                                <input
                                                    class="form-check-input ms-1 me-2 fs-5"
                                                    type="checkbox"
                                                    name="FormInput.SelectedOfficerIds"
                                                    value="@officer.Id" id="of_@officer.Id"
                                                    @(isChecked ? "checked" : "") 
                                                    disabled="@isReadOnly"/>
                                                <label class="form-check-label small fw-bold text-dark pt-0" for="of_@officer.Id">
                                                    @($"{officer.LastName}")
                                                    <span class="text-muted font-monospace small">(@(officer.OfficerAccount?.OfficerTitle ?? "Staff"))</span>
                                                </label>
                                            </div>
                                            @if (!string.IsNullOrEmpty(officer.Email))
                                            {
                                                <a href="mailto:@officer.Email" class="btn btn-sm btn-link text-primary p-0 text-decoration-none" title="Email Officer: @officer.Email">
                                                    <i class="bi bi-envelope-at fs-5"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        
                    <!-- ACCORDION ITEM 4: EVENT PRE-DANCE LESSONS MATRIX -->
            <div class="accordion-item border-0 mb-2 overflow-hidden rounded shadow-sm">
                <h2 class="accordion-header" id="headingLessons">
                    <button class="accordion-button collapsed bg-secondary text-white fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLessons" aria-expanded="false" aria-controls="collapseLessons">
                        <i class="bi bi-journal-bookmark-fill me-2 text-warning"></i>Event Pre-Dance Lessons Matrix
                    </button>
                </h2>
                @* Div collapseLessons *@
                <div id="collapseLessons" class="accordion-collapse collapse" aria-labelledby="headingLessons" data-bs-parent="#danceMatrixAccordion">
                   
                    @* Div Acocordion Body *@
                    <div class="accordion-body bg-white p-4">
                       
                        
                        
                        <div class="mb-3">
    <span class="text-muted small">Configure the pre-dance instruction style, timeframe details, and assign an active lookup registry instructor.</span>
</div>

<!-- 🌟 CLEAN NATIVE 1:1 LESSON INPUT MODULE FORM GRID -->
<div class="bg-light border border-light-subtle rounded-3 p-4 shadow-sm">
    <div class="row g-3">
        
        <!-- Field 1: Lesson Topic/Style Type -->
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.Type">Lesson Topic / Style Type</label>
            <input asp-for="FormInput.AssignedLesson.Type" 
                   type="text" 
                   class="form-control"
                   placeholder="e.g., East Coast Swing (Introductory Class)"
                   disabled="@isReadOnly"
                   required />
            <span asp-validation-for="FormInput.AssignedLesson.Type" class="text-danger small font-monospace"></span>
        </div>

        <!-- Field 2: Assigned Registry Instructor -->
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.InstructorId">Assigned Master Instructor</label>
            <select asp-for="FormInput.AssignedLesson.InstructorId" 
                    class="form-select bg-white" 
                    disabled="@isReadOnly"
                    required>
                <option value="">-- Select Instructor --</option>
                @foreach (var inst in Model.RegistryInstructors)
                {
                    // Assumed Name or FullName property exists on MasterInstructor lookup class
                    <option value="@inst.Id">@inst.Name @(!string.IsNullOrEmpty(inst.Email) ? $"({inst.Email})" : "")</option>
                }
            </select>
            <span asp-validation-for="FormInput.AssignedLesson.InstructorId" class="text-danger small font-monospace"></span>
        </div>

        <!-- Field 3: Lesson Commencement Start Time -->
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.StartTime">Lesson Start Time</label>
            <input asp-for="FormInput.AssignedLesson.StartTime" 
                   type="time" 
                   class="form-control" 
                   disabled="@isReadOnly"
                   required />
            <span asp-validation-for="FormInput.AssignedLesson.StartTime" class="text-danger small font-monospace"></span>
        </div>

        <!-- Field 4: Lesson Wrap-up Conclusion End Time -->
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted mb-1" asp-for="FormInput.AssignedLesson.EndTime">Lesson End Time</label>
            <input asp-for="FormInput.AssignedLesson.EndTime" 
                   type="time" 
                   class="form-control" 
                   disabled="@isReadOnly"
                   required />
            <span asp-validation-for="FormInput.AssignedLesson.EndTime" class="text-danger small font-monospace"></span>
        </div>

    </div>
</div>


                    </div>
                    @* end div accordion body *@
                </div>
                @* EndDiv collapseLessons *@
            </div>
             <!-- End Div ACCORDION ITEM 4: EVENT PRE-DANCE LESSONS MATRIX -->




        
               <!-- FOOTER SAVE AND CANCEL BUTTON CARDS -->
        <div class="card bg-light border-0 p-3 d-flex flex-row justify-content-between align-items-center rounded shadow-sm mt-2">
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i>@(isReadOnly ? "Return" : "Cancel & Return")

            </a>
                   @if (!isReadOnly)
                    {
                        <button type="submit" id="masterSubmitBtn" class="btn btn-dark px-4 btn-lg shadow-sm">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i>Commit Master Configuration Update
                        </button>
                    }
                </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Form intercept double-click thread execution freeze lock protection
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('masterForm');
            const submitBtn = document.getElementById('masterSubmitBtn');

            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    // Check if client-side validation has flagged formatting errors first
                    if (window.jQuery && !jQuery(form).valid()) {
                        return; 
                    }

                    // 1-millisecond dispatch timeout delay preserves CSRF anti-forgery token serialization parameters
                    setTimeout(function() {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing Email Notifiers & DB Queries...';
                    }, 1);
                });
            }
        });
    </script>
}


@page
@model AbdClub.Pages.Officers.Locations.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Location</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Location.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Location.VenueName" class="control-label"></label>
                <input asp-for="Location.VenueName" class="form-control" aria-required="true"/>
                <span asp-validation-for="Location.VenueName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Location.Address" class="control-label"></label>
                <input asp-for="Location.Address" class="form-control" aria-required="true"/>
                <span asp-validation-for="Location.Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location.Description" class="control-label"></label>
                <input asp-for="Location.Description" class="form-control" />
                <span asp-validation-for="Location.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location.GoogleMapsUrl" class="control-label"></label>
                <input asp-for="Location.GoogleMapsUrl" class="form-control" />
                <span asp-validation-for="Location.GoogleMapsUrl" class="text-danger"></span>
            </div>
           <!-- THE INTEGRATED PHOTO UPLOADER PANEL -->
            <div class="form-group mb-3 card bg-light border-light-subtle shadow-sm">
                <div class="card-body p-3">
                    <label class="form-label fw-bold small text-muted mb-1 d-block">
                        <i class="bi bi-image text-primary me-1"></i>Venue Showcase Picture
                    </label>
                    
                    <!-- Standard file picker restricted strictly to image file formats -->
                    <input type="file" name="VenuePhotoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text text-muted" style="font-size: 0.75rem;">
                        Supported formats: PNG, JPG, or WEBP. Max resolution sizes auto-optimize on submission.
                    </div>

                    <!-- In your Edit.cshtml view, show a small thumbnail preview of the current saved image if it exists -->
                    @if (Model.Location?.PhotoUrl != null)
                    {
                        <div class="mt-2 d-flex align-items-center gap-2 border-top pt-2">
                            <span class="small text-muted font-monospace">Current:</span>
                            <img 
                                src="@Model.Location.PhotoUrl"
                                class="rounded border shadow-sm"
                                style="height: 40px; width: 60px; object-fit: cover;"
                                alt="Thumbnail" />
                        </div>
                        <!-- Hidden input to preserve the existing path if they don't upload a new file -->
                        <input type="hidden" asp-for="Location.PhotoUrl" />
                    }
                </div>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-dark w-100">Save Venue Record</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@page "{id:int}"
@model AbdClub.Pages.Officers.Dances.TicketsModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = $"Tickets — {Model.TargetEvent.Title}";
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, null, "isAdmin")).Succeeded;
}

<div class="container py-4" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4 flex-wrap">
        <div>
            <a asp-page="./Index" class="text-decoration-none">&larr; Events</a>
            <h1 class="h2 mt-2 mb-1">@Model.TargetEvent.Title — Tickets</h1>
            <p class="text-muted mb-0">@Model.TargetEvent.Date.ToString("dddd, MMMM d, yyyy") at @Model.TargetEvent.Location.VenueName</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/EventTickets" asp-route-eventId="@Model.TargetEvent.Id" target="_blank" class="btn btn-outline-secondary">Public ticket page</a>
            <a asp-page-handler="Export" asp-route-id="@Model.TargetEvent.Id" class="btn btn-outline-success"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV</a>
            @if (isAdmin)
            {
                <button class="btn btn-dark" type="button" data-bs-toggle="modal" data-bs-target="#ticketTypeModal" onclick="newTicketType()">
                    <i class="bi bi-plus-circle me-1"></i> Ticket type
                </button>
                <button class="btn btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#manualSaleModal">
                    <i class="bi bi-cash me-1"></i> Record door sale
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Gross sales</div><div class="h4 mb-0">@Model.GrossSales.ToString("C")</div></div></div></div>
        <div class="col-6 col-md"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Refunds</div><div class="h4 mb-0">@Model.Refunds.ToString("C")</div></div></div></div>
        <div class="col-6 col-md"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Net sales</div><div class="h4 mb-0">@Model.NetSales.ToString("C")</div></div></div></div>
        <div class="col-6 col-md"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Valid tickets</div><div class="h4 mb-0">@Model.ValidTicketCount</div></div></div></div>
        <div class="col-6 col-md"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Checked in</div><div class="h4 mb-0">@Model.CheckedInCount</div></div></div></div>
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-dark text-white fw-bold">Ticket types and prices</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Name</th><th>Price</th><th>Eligibility</th><th>Sales</th><th>Capacity</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var type in Model.TicketTypes)
                    {
                        var startLocal = TicketsModel.ToCentral(type.SalesStartAt);
                        var endLocal = TicketsModel.ToCentral(type.SalesEndAt);
                        <tr>
                            <td class="fw-semibold">@type.Name</td>
                            <td>@type.Price.ToString("C")</td>
                            <td>
                                @(type.IsMemberOnly ? "Members" : "General")
                                @if (type.IsDoorPrice) { <span class="badge bg-secondary ms-1">Door</span> }
                            </td>
                            <td class="small">
                                @(startLocal?.ToString("g") ?? "Immediately")<br />
                                to @(endLocal?.ToString("g") ?? "No end date")
                            </td>
                            <td>@(type.QuantityAvailable?.ToString() ?? "Unlimited")</td>
                            <td><span class="badge @(type.IsActive ? "bg-success" : "bg-secondary")">@(type.IsActive ? "Active" : "Disabled")</span></td>
                            <td class="text-end">
                                @if (isAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#ticketTypeModal"
                                            data-id="@type.Id" data-name="@type.Name" data-price="@type.Price"
                                            data-start="@(startLocal?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                            data-end="@(endLocal?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                            data-member="@type.IsMemberOnly.ToString().ToLowerInvariant()"
                                            data-door="@type.IsDoorPrice.ToString().ToLowerInvariant()"
                                            data-active="@type.IsActive.ToString().ToLowerInvariant()"
                                            data-capacity="@type.QuantityAvailable" data-order="@type.DisplayOrder"
                                            onclick="editTicketType(this)">Edit</button>
                                    <form method="post" asp-page-handler="DeleteType" asp-route-ticketTypeId="@type.Id" class="d-inline" onsubmit="return confirm('Delete this unused ticket type?');">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.TicketTypes.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No ticket types configured.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">Paid tickets and check-in</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Attendee</th><th>Ticket</th><th>Code</th><th>Purchaser</th><th>Payment</th><th>Check-in</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        foreach (var ticket in order.Tickets.OrderBy(t => t.HolderName))
                        {
                            <tr class="@(ticket.Status == AbdClub.Models.EventTicketStatus.Refunded ? "table-secondary" : ticket.IsCheckedIn ? "table-success" : "")">
                                <td class="fw-semibold">@ticket.HolderName</td>
                                <td>@ticket.TicketTypeName<br /><span class="small text-muted">@ticket.PricePaid.ToString("C")</span></td>
                                <td class="font-monospace small">@ticket.TicketCode</td>
                                <td>@order.PurchaserName<br /><a href="mailto:@order.PurchaserEmail" class="small">@order.PurchaserEmail</a></td>
                                <td>@order.PaymentMethod<br /><span class="badge bg-light text-dark border">@order.Status</span></td>
                                <td>
                                    @if (ticket.IsCheckedIn)
                                    {
                                        <span class="badge bg-success">Checked in</span>
                                        <div class="small text-muted">@TicketsModel.ToCentral(ticket.CheckedInAt)?.ToString("g")</div>
                                    }
                                    else if (ticket.Status == AbdClub.Models.EventTicketStatus.Refunded)
                                    {
                                        <span class="badge bg-secondary">Refunded</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Not checked in</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (ticket.Status == AbdClub.Models.EventTicketStatus.Valid)
                                    {
                                        <form method="post" asp-page-handler="CheckIn" asp-route-ticketId="@ticket.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm @(ticket.IsCheckedIn ? "btn-outline-secondary" : "btn-success")">
                                                @(ticket.IsCheckedIn ? "Undo" : "Check in")
                                            </button>
                                        </form>
                                        @if (isAdmin && !ticket.IsCheckedIn && ticket.PricePaid > 0)
                                        {
                                            <form method="post" asp-page-handler="Refund" asp-route-ticketId="@ticket.Id" class="d-inline" onsubmit="return confirm('Refund this ticket? This cannot be undone.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Refund</button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    @if (!Model.Orders.SelectMany(o => o.Tickets).Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No paid tickets yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (isAdmin)
{
    <div class="modal fade" id="ticketTypeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form method="post" asp-page-handler="SaveType" class="modal-content">
                <div class="modal-header bg-dark text-white"><h2 class="modal-title h5">Ticket type</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body row g-3">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="TypeInput.Id" type="hidden" id="type-id" />
                    <div class="col-md-8"><label asp-for="TypeInput.Name" class="form-label"></label><input asp-for="TypeInput.Name" id="type-name" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="TypeInput.Price" class="form-label"></label><input asp-for="TypeInput.Price" id="type-price" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="TypeInput.SalesStartLocal" class="form-label">Sales start (Central time)</label><input asp-for="TypeInput.SalesStartLocal" id="type-start" type="datetime-local" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="TypeInput.SalesEndLocal" class="form-label">Sales end (Central time)</label><input asp-for="TypeInput.SalesEndLocal" id="type-end" type="datetime-local" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="TypeInput.QuantityAvailable" class="form-label">Capacity (optional)</label><input asp-for="TypeInput.QuantityAvailable" id="type-capacity" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="TypeInput.DisplayOrder" class="form-label">Display order</label><input asp-for="TypeInput.DisplayOrder" id="type-order" class="form-control" /></div>
                    <div class="col-12 d-flex gap-4 flex-wrap">
                        <div class="form-check"><input asp-for="TypeInput.IsMemberOnly" id="type-member" class="form-check-input" /><label asp-for="TypeInput.IsMemberOnly" class="form-check-label">Member price</label></div>
                        <div class="form-check"><input asp-for="TypeInput.IsDoorPrice" id="type-door" class="form-check-input" /><label asp-for="TypeInput.IsDoorPrice" class="form-check-label">Door price (not sold online)</label></div>
                        <div class="form-check"><input asp-for="TypeInput.IsActive" id="type-active" class="form-check-input" /><label asp-for="TypeInput.IsActive" class="form-check-label">Active</label></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-dark">Save ticket type</button></div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="manualSaleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="ManualSale" class="modal-content">
                <div class="modal-header bg-danger text-white"><h2 class="modal-title h5">Record door or manual sale</h2><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body vstack gap-3">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div><label asp-for="ManualInput.TicketTypeId" class="form-label">Ticket type</label><select asp-for="ManualInput.TicketTypeId" class="form-select"><option value="">Select</option>@foreach (var type in Model.TicketTypes.Where(t => t.IsActive)) { <option value="@type.Id">@type.Name — @type.Price.ToString("C")</option> }</select></div>
                    <div><label asp-for="ManualInput.HolderName" class="form-label">Attendee name</label><input asp-for="ManualInput.HolderName" class="form-control" /></div>
                    <div><label asp-for="ManualInput.MemberNumber" class="form-label">Member number (for member price)</label><input asp-for="ManualInput.MemberNumber" class="form-control" placeholder="10001" /></div>
                    <div><label asp-for="ManualInput.PurchaserName" class="form-label">Purchaser name</label><input asp-for="ManualInput.PurchaserName" class="form-control" /></div>
                    <div><label asp-for="ManualInput.PurchaserEmail" class="form-label">Purchaser email</label><input asp-for="ManualInput.PurchaserEmail" type="email" class="form-control" /></div>
                    <div><label asp-for="ManualInput.PurchaserPhone" class="form-label">Phone</label><input asp-for="ManualInput.PurchaserPhone" class="form-control" /></div>
                    <div><label asp-for="ManualInput.PaymentMethod" class="form-label">Payment method</label><select asp-for="ManualInput.PaymentMethod" class="form-select"><option>Cash</option><option>Card</option><option>Check</option><option>Complimentary</option></select></div>
                    <div><label asp-for="ManualInput.TransactionId" class="form-label">Transaction/reference ID (optional)</label><input asp-for="ManualInput.TransactionId" class="form-control" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Record ticket</button></div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (Model.ShowTicketTypeModal)
            {
                <text>bootstrap.Modal.getOrCreateInstance(document.getElementById('ticketTypeModal')).show();</text>
            }
            @if (Model.ShowManualSaleModal)
            {
                <text>bootstrap.Modal.getOrCreateInstance(document.getElementById('manualSaleModal')).show();</text>
            }
        });
        function newTicketType() {
            document.getElementById('type-id').value = '';
            document.getElementById('type-name').value = '';
            document.getElementById('type-price').value = '';
            document.getElementById('type-start').value = '';
            document.getElementById('type-end').value = '';
            document.getElementById('type-capacity').value = '';
            document.getElementById('type-order').value = '0';
            document.getElementById('type-member').checked = false;
            document.getElementById('type-door').checked = false;
            document.getElementById('type-active').checked = true;
        }
        function editTicketType(button) {
            document.getElementById('type-id').value = button.dataset.id;
            document.getElementById('type-name').value = button.dataset.name;
            document.getElementById('type-price').value = button.dataset.price;
            document.getElementById('type-start').value = button.dataset.start;
            document.getElementById('type-end').value = button.dataset.end;
            document.getElementById('type-capacity').value = button.dataset.capacity;
            document.getElementById('type-order').value = button.dataset.order;
            document.getElementById('type-member').checked = button.dataset.member === 'true';
            document.getElementById('type-door').checked = button.dataset.door === 'true';
            document.getElementById('type-active').checked = button.dataset.active === 'true';
        }
    </script>
}
